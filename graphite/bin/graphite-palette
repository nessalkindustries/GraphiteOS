#!/usr/bin/env python3
"""Offline wallpaper palette extraction for Graphite (desk-5).

graphite-palette IMAGE [--mode dark|light] [--name NAME] > colors.toml

Quantizes a downscaled copy of IMAGE (Pillow median cut), picks the most
vivid usable colour as the accent and the dominant hue for the neutrals, and
prints a colors.toml in the same flat format as the shipped themes. No network.
"""
import argparse, colorsys, os, sys
from PIL import Image

def hexc(rgb):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(c * 255))) for c in rgb)

def hls(h, l, s):
    return colorsys.hls_to_rgb(h % 1.0, max(0, min(1, l)), max(0, min(1, s)))

def lum(rgb):
    def ch(c):
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (ch(c) for c in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

def contrast(a, b):
    la, lb = sorted((lum(a), lum(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)

def extract(path, n=8):
    im = Image.open(path).convert("RGB")
    im.thumbnail((128, 128))
    q = im.quantize(colors=n, method=Image.Quantize.MEDIANCUT)
    pal = q.getpalette()[: n * 3]
    counts = sorted(q.getcolors(), reverse=True)
    out = []
    for cnt, idx in counts:
        rgb = tuple(c / 255 for c in pal[idx * 3: idx * 3 + 3])
        out.append((cnt, rgb))
    return out

def build(colors, mode, name, wallpaper):
    total = sum(c for c, _ in colors) or 1
    # dominant hue (for neutrals): weighted by area
    h0, _, s0 = colorsys.rgb_to_hls(*colors[0][1])
    # accent: most vivid colour, weighted a little by area, not too dark/light
    def score(item):
        cnt, rgb = item
        h, l, s = colorsys.rgb_to_hls(*rgb)
        return s * (1 - abs(l - 0.55)) + 0.15 * cnt / total
    _, arg = max(colors, key=score)
    ha, la, sa = colorsys.rgb_to_hls(*arg)
    sa = max(sa, 0.45)
    ns = min(s0, 0.18)            # neutrals keep only a hint of the dominant hue
    dark = mode == "dark"
    if dark:
        bg, sf, ov, bd = (hls(h0, l, ns) for l in (0.09, 0.13, 0.17, 0.24))
        fg, mu = hls(h0, 0.86, 0.08), hls(h0, 0.55, 0.06)
        accent = hls(ha, 0.68, sa)
    else:
        bg, sf, ov, bd = (hls(h0, l, ns) for l in (0.96, 0.92, 0.88, 0.80))
        fg, mu = hls(h0, 0.14, 0.10), hls(h0, 0.42, 0.06)
        accent = hls(ha, 0.40, sa)
    # keep the accent readable against the background
    step = 0.03 if dark else -0.03
    l = colorsys.rgb_to_hls(*accent)[1]
    while contrast(accent, bg) < 3.0 and 0.05 < l < 0.95:
        l += step; accent = hls(ha, l, sa)
    accent2 = hls(ha + 0.08, colorsys.rgb_to_hls(*accent)[1], sa * 0.9)
    on_accent = hls(ha, 0.08, 0.3) if lum(accent) > 0.25 else hls(ha, 0.96, 0.2)
    al = 0.70 if dark else 0.42
    std = {"red": 0.0, "green": 0.33, "yellow": 0.13, "blue": 0.6, "magenta": 0.8, "cyan": 0.5}
    lines = [
        "# Generated by `graphite theme from-wallpaper` (offline palette extraction).",
        f'name       = "{name}"',
        f'mode       = "{mode}"',
    ]
    for k, v in (("background", bg), ("surface", sf), ("overlay", ov), ("border", bd),
                 ("foreground", fg), ("muted", mu), ("accent", accent), ("accent2", accent2),
                 ("on_accent", on_accent)):
        lines.append(f'{k:<10} = "{hexc(v)}"')
    for k, h in std.items():
        lines.append(f'{k:<10} = "{hexc(hls(h, al, 0.65))}"')
    lines += [
        f'gtk_theme  = "{"adw-gtk3-dark" if dark else "adw-gtk3"}"',
        f'icon_theme = "{"Papirus-Dark" if dark else "Papirus-Light"}"',
        f'scheme     = "{"prefer-dark" if dark else "prefer-light"}"',
        f'wallpaper  = "{wallpaper}"',
    ]
    return "\n".join(lines) + "\n"

def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("image")
    ap.add_argument("--mode", choices=("dark", "light"), default="dark")
    ap.add_argument("--name", default="From wallpaper")
    ap.add_argument("--wallpaper", help="wallpaper value to write (default: the image path)")
    a = ap.parse_args()
    try:
        cols = extract(a.image)
    except Exception as e:
        print(f"graphite-palette: cannot read {a.image}: {e}", file=sys.stderr); sys.exit(1)
    sys.stdout.write(build(cols, a.mode, a.name, a.wallpaper or os.path.abspath(a.image)))

if __name__ == "__main__":
    main()
