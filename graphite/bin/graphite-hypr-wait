#!/usr/bin/env bash
# graphite-hypr-wait CMD...: start CMD once the Hyprland session is ready for Wayland clients.
# Hyprland 0.57 fires hl.on("hyprland.start") early: clients started there could find no
# compositor socket yet (WAYLAND_DISPLAY unset/not listening) and exit, e.g. the first-boot setup.
for _ in $(seq 100); do
  if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
    WAYLAND_DISPLAY=$(hyprctl instances -j 2>/dev/null | sed -n 's/.*"wl_socket": *"\([^"]*\)".*/\1/p' | head -1)
    [[ -n $WAYLAND_DISPLAY ]] && export WAYLAND_DISPLAY
  fi
  [[ -n ${WAYLAND_DISPLAY:-} && -S ${XDG_RUNTIME_DIR:-/run/user/$UID}/$WAYLAND_DISPLAY ]] && hyprctl monitors >/dev/null 2>&1 && break
  sleep 0.2
done
exec "$@"
