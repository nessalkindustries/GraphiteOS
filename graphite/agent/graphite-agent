def config_path(path):
    """Resolve a requested config path, or raise ValueError. Validation outside the model."""
    if not isinstance(path, str) or not path or len(path) > 256 or "\0" in path:
        raise ValueError("path must be a short string")
    home = os.path.realpath(os.path.expanduser("~"))
    p = os.path.expanduser(path) if path.startswith("~/") else path
    if not os.path.isabs(p):
        p = os.path.join(home, ".config", p)
    real = os.path.realpath(p)
    dirs = [os.path.realpath(os.path.expanduser(d)) for d in CONFIG_DIRS]
    if not (real in CONFIG_FILES or any(real.startswith(d + os.sep) for d in dirs)):
        raise ValueError("not an allowed config file (only ~/.config/{hypr,graphite,kitty,"
                         "quickshell,mako,waybar,gtk-3.0,gtk-4.0} and a few /etc files)")
    if not os.path.isfile(real):
        raise ValueError("no such file")
    return real

def read_config(path):
    real = config_path(path)
    with open(real, "rb") as f:
        data = f.read(65536).decode("utf-8", "replace")
    lines = [("<redacted>" if SECRET.search(l) else l) for l in data.splitlines()]
    return {"path": real, "content": "\n".join(lines)[:TOOL_RESULT_MAX - 200]}

