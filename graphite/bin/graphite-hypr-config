#!/usr/bin/env bash
# Pick the Hyprland config format for the installed Hyprland:
#   < 0.57: ~/.config/hypr/hyprland.conf (hyprlang, shipped in /etc/skel) - nothing to do
#   >= 0.57: legacy .conf support is removed upstream (PR #15539); install hyprland.lua next to it
# Usage: graphite-hypr-config [check|apply|provider]
#   check: conf|lua for the installed Hyprland; provider: hyprlang|lua for the running session
set -euo pipefail
SHARE=${GRAPHITE_SHARE:-/usr/share/graphite}
HYPR=${XDG_CONFIG_HOME:-$HOME/.config}/hypr
ver=$(Hyprland --version 2>/dev/null | grep -oE 'Hyprland [0-9]+\.[0-9]+' | head -1 | cut -d' ' -f2 || true)
[[ -n ${GRAPHITE_HYPR_VERSION:-} ]] && ver=$GRAPHITE_HYPR_VERSION
fmt=conf
if [[ -n $ver ]]; then IFS=. read -r ma mi <<<"$ver"; (( ma > 0 || mi >= 57 )) && fmt=lua; fi
case ${1:-apply} in
  check) echo "$fmt" ;;
  provider)   # running session: `hyprctl status -j` has configProvider since 0.55; older = hyprlang
    p=$(timeout 5 hyprctl status -j 2>/dev/null | sed -n 's/.*"configProvider"[^"]*"\([a-z]*\)".*/\1/p' | head -1)
    [[ -n $p ]] || { [[ $fmt = lua ]] && p=lua || p=hyprlang; }
    echo "$p" ;;
  apply)
    [[ $fmt = lua ]] || exit 0
    mkdir -p "$HYPR"
    # never overwrite a user's own Lua config; Hyprland's autogenerated example (written when
    # Hyprland started before this ran) is not one
    if [[ -f $HYPR/hyprland.lua ]] && head -1 "$HYPR/hyprland.lua" | grep -q '^-- This is an example Hyprland Lua config file'; then
      mv -f "$HYPR/hyprland.lua" "$HYPR/hyprland.lua.autogenerated"
    fi
    [[ -f $HYPR/hyprland.lua ]] || install -m644 "$SHARE/templates/hypr-lua/hyprland.lua" "$HYPR/hyprland.lua"
    ;;
  *) echo "usage: graphite-hypr-config [check|apply|provider]" >&2; exit 2 ;;
esac
