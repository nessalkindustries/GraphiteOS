{
  "layer": "top", "position": "top", "height": 30,
  "modules-left": ["custom/logo", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["custom/gamemode", "cpu", "memory", "pulseaudio", "network", "battery", "tray"],
  "custom/logo": { "format": "  GraphiteOS", "on-click": "rofi -show drun" },
  "custom/gamemode": { "exec": "gamemoded -s | grep -q 'is active' && echo '󰊴 GM' || echo ''", "interval": 5 },
  "clock": { "format": "{:%a %d %b  %H:%M}" },
  "cpu": { "format": " {usage}%" },
  "memory": { "format": " {}%" },
  "pulseaudio": { "format": " {volume}%", "on-click": "pavucontrol" },
  "network": { "format-ethernet": "󰈀 {ipaddr}", "format-wifi": " {essid}", "format-disconnected": "󰖪" },
  "battery": { "format": "{icon} {capacity}%", "format-icons": ["","","","",""] }
}
