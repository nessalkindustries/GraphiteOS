#!/usr/bin/env bash
# shellcheck disable=SC2016,SC2012  # eval strings in doctor(); module dir names are plain
# Graphite command center.
set -euo pipefail
GRAPHITE_PATH=${GRAPHITE_PATH:-/usr/share/graphite}
export GRAPHITE_PATH
# HOME is unset under systemd units / some sudo setups
: "${HOME:=$(getent passwd "$(id -un)" | cut -d: -f6)}"
export HOME
STATE_DIR="$HOME/.local/state/graphite"
NEWS_URL=${GRAPHITE_NEWS_URL:-https://archlinux.org/feeds/news/}

help() {
  cat <<HELP
Graphite command center ($(cat "$GRAPHITE_PATH/VERSION" 2>/dev/null || echo dev))

Usage: graphite <command> [args]
  update [--yes] [--no-news]  Arch news check -> pacman -Syu -> migrations -> pacnew report
  repo                        [graphite] repo status: servers, signature policy, trusted keys
  migrate [--pending]         run (or list) pending migrations for this user
  bar [status|quickshell|waybar]  which bar runs: Quickshell (default) or Waybar (opt-out)
  theme list|current|set N|pick|from-wallpaper IMG [--light]
                             themes (colors.toml -> generated configs; Super+T)
  splash on|off|status        Plymouth boot splash (initramfs hook + 'splash' on the kernel cmdline)
  control [status|...]       control center: volume, brightness, Wi-Fi, Bluetooth, power, theme (Super+A)
  settings [get|set K V|...]  Settings app: appearance, display, input, network, about (Super+I)
  firstboot [open|reset|...]  guided first-boot setup (theme, wallpaper, privacy, profiles, Secure Boot)
  gpu status|plan|setup       detect Intel/AMD/NVIDIA GPUs and install the matching driver stack
  audio status|default|lowlatency [Q]  PipeWire latency presets (rtkit realtime)
  perf status|kernel zen|tune gaming   opt-in linux-zen kernel and gaming sysctl/power preset
  profile status|gaming|creator|...    install a workload profile (Steam/gamescope, OBS/VA-API/NVENC)
  sync list|export|import              settings to/from a tarball, folder/USB or git repo (no cloud)
  apps list|search|install|remove      app store backend (Arch repos + optional Flathub; Settings > Apps)
  keybinds                    keybinding cheatsheet (also Super+K)
  snapshots                   list Snapper snapshots of /
  rollback N                  make snapshot N the new root (reboot afterwards)
  secureboot status|plan|setup|sign|verify   opt-in Secure Boot with sbctl (docs/secure-boot.md)
  doctor                      health checks (services, portals, snapshots, firewall, zram)
  install [args]              run the installer (install.sh)
  version | debug | help
HELP
}

# --- Arch news: show items published since the last successful update -------
news_check() {
  local yes=$1 last items
  last=$(cat "$STATE_DIR/last-update" 2>/dev/null || echo 0)
  items=$(curl -fsS --max-time 15 "$NEWS_URL" 2>/dev/null | python3 -c '
import sys, email.utils, xml.etree.ElementTree as ET
last = float(sys.argv[1])
try: root = ET.fromstring(sys.stdin.read())
except Exception: sys.exit(2)
for it in root.iter("item"):
    ts = email.utils.parsedate_to_datetime(it.findtext("pubDate")).timestamp()
    if ts > last: print("  * %s  (%s)\n    %s" % (it.findtext("title"), it.findtext("pubDate")[:16], it.findtext("link")))
' "$last") || { echo "Arch news: could not fetch $NEWS_URL (offline?). Check https://archlinux.org/news/ manually."; return 0; }
  if [[ -z $items ]]; then
    echo "Arch news: nothing new since the last update."
  else
    echo "Arch news since your last update (read before upgrading; manual steps happen here):"
    echo "$items"
    if [[ $yes != 1 ]]; then
      read -r -p "Continue with the update? [y/N] " a
      [[ $a == [yY]* ]] || { echo "Update cancelled."; exit 1; }
    fi
  fi
}

update() {
  local yes=0 news=1
  while (($#)); do
    case $1 in --yes|-y) yes=1 ;; --no-news) news=0 ;; *) echo "unknown option $1" >&2; exit 1 ;; esac
    shift
  done
  mkdir -p "$STATE_DIR"
  [[ -f $HOME/.config/graphite/privacy/no-news ]] && news=0   # first-boot privacy choice
  ((news)) && news_check "$yes"
  # Graphite's own code arrives as the graphite-config package from [graphite];
  # there is no separate code channel: pacman is the only updater.
  # explicit, labelled pre-update snapshot (snap-pac's pre/post pair is per transaction;
  # this one marks the whole `graphite update` and is what docs/recovery.md points to)
  if command -v snapper >/dev/null && sudo snapper -c root list >/dev/null 2>&1; then
    local snapn
    snapn=$(sudo snapper -c root create -c number -p -d "graphite update $(date +%F_%H:%M)" 2>/dev/null) &&
      echo "--- pre-update snapshot: #$snapn (undo with: graphite rollback $snapn)"
  fi
  local pacargs=(-Syu)
  ((yes)) && pacargs+=(--noconfirm)
  # new or rotated repo keys must be in the keyring before packages signed with them
  # arrive (same pattern as archlinux-keyring); it is part of the same -Syu below
  if pacman -Q graphite-keyring >/dev/null 2>&1; then
    sudo pacman -Sy --needed "${pacargs[@]:1}" graphite-keyring
  fi
  sudo pacman "${pacargs[@]}"
  date +%s > "$STATE_DIR/last-update"
  graphite-migrate
  echo "--- configuration files needing attention (.pacnew/.pacsave):"
  if command -v pacdiff >/dev/null; then
    out=$(pacdiff -o 2>/dev/null || true)
    if [[ -n $out ]]; then echo "$out"; echo "Merge them with: sudo DIFFPROG='nvim -d' pacdiff"; else echo "none"; fi
  fi
  if command -v arch-audit >/dev/null; then
    n=$(arch-audit -u 2>/dev/null | wc -l || true)
    echo "--- arch-audit: $n installed package(s) with known vulnerabilities that already have fixes (run: arch-audit -u)"
  fi
  if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
    echo "--- kernel updated: reboot to use the new kernel."
  fi
}

repo() {
  echo "[graphite] servers (first that answers wins):"
  sed -n '/^\[graphite\]/,/^\[/{/^Server/s/^Server = /  /p}' /etc/pacman.conf
  echo "signatures: $(sed -n '/^\[graphite\]/,/^\[/{s/^SigLevel = //p}' /etc/pacman.conf)"
  if pacman -Q graphite-keyring >/dev/null 2>&1; then
    echo "keyring: $(pacman -Q graphite-keyring)"
    echo "trusted keys:"; sed 's/:.*//; s/^/  /' /usr/share/pacman/keyrings/graphite-trusted
    [[ -s /usr/share/pacman/keyrings/graphite-revoked ]] && { echo "revoked:"; sed 's/^/  /' /usr/share/pacman/keyrings/graphite-revoked; }
  else
    echo "keyring: graphite-keyring not installed (unsigned or older install)"
  fi
  echo "installed from [graphite]:"; pacman -Sl graphite 2>/dev/null | awk '$4=="[installed]"||$4~/installed/{print "  "$2" "$3}' || true
}

snapshots() { sudo snapper -c root list; }

# --- rollback: flat Btrfs layout (@ is the root subvolume) -------------------
rollback() {
  local n=${1:?usage: graphite rollback SNAPSHOT_NUMBER}
  [[ $n =~ ^[0-9]+$ ]] || { echo "snapshot number expected" >&2; exit 1; }
  [[ $EUID -eq 0 ]] || exec sudo GRAPHITE_PATH="$GRAPHITE_PATH" "$0" rollback "$@"
  local dev top ts snap
  dev=$(findmnt -no SOURCE / | sed 's/\[.*\]//')
  top=$(mktemp -d)
  mount -o subvolid=5 "$dev" "$top"
  snap="$top/@snapshots/$n/snapshot"
  [[ -d $snap ]] || { umount "$top"; echo "snapshot $n not found" >&2; exit 1; }
  ts=$(date +%Y%m%d-%H%M%S)
  # snapper's own pre-rollback safety snapshot of the current state
  snapper -c root create -d "before rollback to $n" -c number >/dev/null 2>&1 || true
  mv "$top/@" "$top/@.before-rollback-$ts"
  btrfs subvolume snapshot "$snap" "$top/@" >/dev/null
  # snap-pac "pre" snapshots are taken mid-transaction and contain pacman's lock
  rm -f "$top/@/var/lib/pacman/db.lck"
  # the kernel and initramfs live on the ESP (/boot) and are NOT rolled back
  local snapk curk
  snapk=$(ls "$top/@/usr/lib/modules" 2>/dev/null | sort -V | tail -1)
  curk=$(ls /usr/lib/modules | sort -V | tail -1)
  if [[ -n $snapk && $snapk != "$curk" ]]; then
    echo "WARNING: snapshot $n has kernel modules $snapk, but /boot (ESP, not snapshotted) has $curk."
    echo "         After rebooting run: sudo pacman -S linux linux-lts   (or pick the LTS entry in GRUB)."
  fi
  umount "$top"; rmdir "$top"
  echo "Rolled back: @ is now a copy of snapshot $n; old root kept as @.before-rollback-$ts."
  echo "Reboot to use it. Delete the old root later with: btrfs subvolume delete (via subvolid=5 mount)."
}

doctor() {
  local fail=0
  check() { if eval "$2" >/dev/null 2>&1; then printf '  ok    %s\n' "$1"; else printf '  FAIL  %s\n' "$1"; fail=1; fi; }
  echo "System"
  check "no failed systemd units" '[[ -z $(systemctl --failed --no-legend --plain) ]]'
  check "firewall (graphite-firewall) active" 'systemctl is-active graphite-firewall.service'
  check "zram swap active" 'grep -q zram /proc/swaps'
  check "snapper root config" 'test -f /etc/snapper/configs/root'
  check "grub-btrfsd running" 'systemctl is-active grub-btrfsd.service'
  check "power-profiles-daemon active" 'systemctl is-active power-profiles-daemon.service'
  check "timers: fstrim paccache reflector" 'systemctl is-enabled fstrim.timer paccache.timer reflector.timer'
  check "sudo requires a password for wheel" '! grep -rqs NOPASSWD /etc/sudoers.d/10-graphite-wheel'
  echo "Desktop"
  check "xdg-desktop-portal-hyprland installed" 'pacman -Q xdg-desktop-portal-hyprland'
  check "xdg-desktop-portal-gtk installed" 'pacman -Q xdg-desktop-portal-gtk'
  if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    check "xdg-desktop-portal running" 'systemctl --user is-active xdg-desktop-portal.service'
    check "pipewire running" 'systemctl --user is-active pipewire.service'
  fi
  check "theme files generated" "test -f $HOME/.config/graphite/current/hyprland.conf"
  return $fail
}

# --- Plymouth boot splash ----------------------------------------------------
# on : graphite Plymouth theme, `plymouth` hook before `encrypt` (so the LUKS
#      passphrase is asked on the splash), `splash` on the GRUB kernel cmdline.
# --no-rebuild skips mkinitcpio/grub-mkconfig (the installer runs those itself).
splash() {
  local action=${1:-status} rebuild=1 hooks
  [[ ${2:-} == --no-rebuild ]] && rebuild=0
  hooks=$(sed -n 's/^HOOKS=(\(.*\))/\1/p' /etc/mkinitcpio.conf)
  case $action in
    status)
      echo "theme:   $(plymouth-set-default-theme 2>/dev/null || echo 'plymouth not installed')"
      [[ " $hooks " == *" plymouth "* ]] && echo "hook:    yes" || echo "hook:    no"
      grep -qE '^GRUB_CMDLINE_LINUX_DEFAULT=.*\bsplash\b' /etc/default/grub && echo "cmdline: splash" || echo "cmdline: no splash"
      return 0 ;;
    on|off) ;;
    *) echo "usage: graphite splash on|off|status [--no-rebuild]" >&2; return 1 ;;
  esac
  [[ $EUID -eq 0 ]] || exec sudo GRAPHITE_PATH="$GRAPHITE_PATH" "$0" splash "$@"
  if [[ $action == on ]]; then
    command -v plymouth-set-default-theme >/dev/null || { echo "plymouth is not installed (sudo pacman -S plymouth)" >&2; return 1; }
    plymouth-set-default-theme graphite
    if [[ " $hooks " != *" plymouth "* ]]; then
      if [[ " $hooks " == *" encrypt "* ]]; then hooks=${hooks/encrypt/plymouth encrypt}
      elif [[ " $hooks " == *" block "* ]]; then hooks=${hooks/block/plymouth block}
      else hooks="$hooks plymouth"; fi
    fi
    grep -qE '^GRUB_CMDLINE_LINUX_DEFAULT=.*\bsplash\b' /etc/default/grub \
      || sed -i -E 's/^(GRUB_CMDLINE_LINUX_DEFAULT=".*)"/\1 splash"/' /etc/default/grub
  else
    hooks=$(sed -E 's/(^| )plymouth( |$)/ /; s/^ //; s/ $//' <<<"$hooks")
    sed -i -E 's/^(GRUB_CMDLINE_LINUX_DEFAULT=".*) splash(.*")/\1\2/' /etc/default/grub
  fi
  sed -i "s/^HOOKS=.*/HOOKS=($hooks)/" /etc/mkinitcpio.conf
  if ((rebuild)); then
    mkinitcpio -P && grub-mkconfig -o /boot/grub/grub.cfg
  fi
  echo "boot splash: $action"
}

# --- bar: Quickshell (default) or Waybar; graphite-bar starts whichever is chosen ---
bar() {
  local f=${XDG_CONFIG_HOME:-$HOME/.config}/graphite/bar cur
  cur=$(cat "$f" 2>/dev/null || true); [[ $cur == waybar ]] || cur=quickshell
  case ${1:-status} in
    status)
      echo "bar: $cur$([[ -f $f ]] || echo " (default)")"
      if pgrep -x qs >/dev/null; then echo "running: quickshell"; elif pgrep -x waybar >/dev/null; then echo "running: waybar"; else echo "running: none"; fi ;;
    quickshell|waybar)
      mkdir -p "${f%/*}"; echo "$1" > "$f"
      echo "bar set to $1"
      if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
        # through Hyprland, so the bar gets the compositor's environment (see graphite-theme)
        # under load a dispatch can be lost (hyprctl gets no answer): confirm the restart really
        # started, retry, and as a last resort start it here so the switch never silently no-ops
        local want=qs other=waybar ok=0; [[ $1 == waybar ]] && { want=waybar; other=qs; }
        for _ in 1 2 3; do
          timeout 15 hyprctl dispatch exec "graphite-bar --restart" >/dev/null 2>&1 || true
          for _ in $(seq 30); do pgrep -f '(^|/)graphite-bar --restart' >/dev/null && { ok=1; break 2; }; sleep 0.5; done
        done
        ((ok)) || setsid -f graphite-bar --restart >/dev/null 2>&1
        sleep 1; for _ in $(seq 900); do pgrep -f '(^|/)graphite-bar --restart' >/dev/null || break; sleep 0.5; done
        pgrep -x "$want" >/dev/null && ! pgrep -x "$other" >/dev/null || echo "warning: bar switch not finished yet" >&2
        bar status | tail -1
      else
        echo "takes effect at the next login"
      fi ;;
    *) echo "usage: graphite bar [status|quickshell|waybar]" >&2; return 1 ;;
  esac
}

cmd=${1:-help}; shift || true
case $cmd in
  update) update "$@" ;;
  repo) repo ;;
  migrate) graphite-migrate "$@" ;;
  bar) bar "$@" ;;
  theme) graphite-theme "$@" ;;
  keybinds) graphite-keybinds "$@" ;;
  control) graphite-control "$@" ;;
  settings) graphite-settings "$@" ;;
  firstboot|welcome) graphite-firstboot "$@" ;;
  gpu) graphite-gpu "$@" ;;
  audio) graphite-audio "$@" ;;
  perf) graphite-perf "$@" ;;
  profile) graphite-profile "$@" ;;
  sync) graphite-sync "$@" ;;
  apps) graphite-apps "$@" ;;
  snapshots) snapshots ;;
  rollback) rollback "$@" ;;
  splash) splash "$@" ;;
  secureboot) exec graphite-secureboot "$@" ;;
  doctor) doctor ;;
  install) exec "$GRAPHITE_PATH/install.sh" "$@" ;;
  version) cat "$GRAPHITE_PATH/VERSION" ;;
  debug)
    echo "graphite: $(cat "$GRAPHITE_PATH/VERSION") at $GRAPHITE_PATH"
    uname -a
    grep -E '^(PRETTY_NAME|ID)=' /etc/os-release || true
    cat /usr/lib/graphite-release 2>/dev/null || true
    echo "pending migrations:"; graphite-migrate --pending || echo "  none"
    if command -v hyprctl >/dev/null; then hyprctl version 2>/dev/null | head -1; fi
    doctor || true ;;
  help|-h|--help) help ;;
  *) echo "unknown command: $cmd" >&2; help >&2; exit 1 ;;
esac
