def run_tool(name, raw_args):
    """Validate a model-requested call outside the model. Returns (ok, result)."""
    if name not in TOOLS:
        return False, {"error": f"tool '{name}' does not exist; only {', '.join(TOOLS)} are "
                                "available, and none can change the system"}
    try:
        args = json.loads(raw_args) if (raw_args or "").strip() else {}
    except ValueError:
        return False, {"error": "arguments are not valid JSON"}
    if not isinstance(args, dict):
        return False, {"error": "arguments must be an object"}
    schema = TOOLS[name][1]
    props = schema["properties"]
    for k, v in args.items():
        if k not in props:
            return False, {"error": f"unknown argument '{k}'"}
        if props[k].get("type") == "string" and not isinstance(v, str):
            return False, {"error": f"'{k}' must be a string"}
        if "maxLength" in props[k] and len(v) > props[k]["maxLength"]:
            return False, {"error": f"'{k}' is too long"}
        if "enum" in props[k] and v not in props[k]["enum"]:
            return False, {"error": f"'{k}' must be one of {props[k]['enum']}"}
    for k in schema.get("required", []):
        if k not in args:
            return False, {"error": f"missing argument '{k}'"}
    try:
        return True, TOOLS[name][0](**args)
    except ValueError as e:         # refused by the tool's own validation (e.g. a path)
        return False, {"error": str(e)}
    except Exception as e:          # a read failed; report it, never crash the answer
        return False, {"error": f"{type(e).__name__}: {e}"}

# ---------------------------------------------------------------- store: tasks, audit, notes

STATES = {"running": {"done", "failed", "cancelled", "interrupted"}}   # every other state is final
STOPWORDS = set("the a an and or of to in on for is are was were what which how do does did my "
                "me i you it its this that with can could at be about from have has any there "
                "please tell show".split())
NOTE_SECRET = re.compile(r"(?i)(pass(word|wd|phrase)|api[_ -]?key|secret|token|private key|"
                         r"-----BEGIN|\b[A-Za-z0-9+/_-]{32,}\b)")

class Store:
    """~/.local/share/graphite-agent/agent.db (0600, WAL, secure_delete): tasks, events, notes."""
    def __init__(self, path=None):
        path = path or DB_PATH
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        old = os.umask(0o077)
        try:
            self.db = sqlite3.connect(path, timeout=10, isolation_level=None, check_same_thread=False)
            x = self.db.execute
            x("PRAGMA journal_mode=WAL"); x("PRAGMA secure_delete=ON")
            x("CREATE TABLE IF NOT EXISTS tasks(id INTEGER PRIMARY KEY, created REAL, updated REAL,"
              " state TEXT, question TEXT, answer TEXT, error TEXT, tool_calls INTEGER DEFAULT 0)")
            x("CREATE TABLE IF NOT EXISTS events(id INTEGER PRIMARY KEY, task_id INTEGER, ts REAL,"
              " kind TEXT, data TEXT)")
            x("CREATE INDEX IF NOT EXISTS events_task ON events(task_id)")
            x("CREATE VIRTUAL TABLE IF NOT EXISTS notes USING fts5(text, created UNINDEXED,"
              " tokenize='porter unicode61')")
            x("CREATE TABLE IF NOT EXISTS prefs(key TEXT PRIMARY KEY, value TEXT)")
        finally:
            os.umask(old)
        self.lock = threading.Lock()

    def pref(self, key, default=None):
        r = self.db.execute("SELECT value FROM prefs WHERE key=?", (key,)).fetchone()
        return r[0] if r else default
    def set_pref(self, key, value):
        self.db.execute("INSERT OR REPLACE INTO prefs VALUES(?,?)", (key, value))

    # tasks: an explicit state machine; only running -> a final state is allowed
    def new_task(self, question):
        keep = self.pref("history", "on") == "on"
        now = time.time()
        with self.lock:
            tid = self.db.execute("INSERT INTO tasks(created,updated,state,question) VALUES(?,?,?,?)",
                                  (now, now, "running", question if keep else None)).lastrowid
        self.event(tid, "state", state="running")
        return tid
    def transition(self, tid, state, answer=None, error=None, tool_calls=None):
        with self.lock:
            r = self.db.execute("SELECT state FROM tasks WHERE id=?", (tid,)).fetchone()
            if not r or state not in STATES.get(r[0], ()):
                return False
            keep = self.pref("history", "on") == "on"
            self.db.execute("UPDATE tasks SET state=?, updated=?, answer=?, error=?,"
                            " tool_calls=COALESCE(?, tool_calls) WHERE id=?",
                            (state, time.time(), answer if keep else None, error, tool_calls, tid))
        self.event(tid, "state", state=state, **({"error": error} if error else {}))
        return True
    def event(self, tid, kind, **data):
        with self.lock:
            self.db.execute("INSERT INTO events(task_id,ts,kind,data) VALUES(?,?,?,?)",
                            (tid, time.time(), kind, json.dumps(data)[:4000]))
    def recover(self):
        """After a crash/restart: running tasks become interrupted. Nothing is replayed."""
        ids = [r[0] for r in self.db.execute("SELECT id FROM tasks WHERE state='running'")]
        for tid in ids:
            self.transition(tid, "interrupted", error="the agent stopped while this was running; "
                            "not resumed automatically")
        return ids
    def prune(self):
        cut = time.time() - RETENTION_DAYS * 86400
        with self.lock:
            self.db.execute("DELETE FROM events WHERE task_id IN (SELECT id FROM tasks WHERE updated<?)", (cut,))
            self.db.execute("DELETE FROM tasks WHERE updated<?", (cut,))
    def tasks(self, n=20):
        return [dict(zip(("id", "created", "state", "question", "answer", "error", "tool_calls"), r))
                for r in self.db.execute("SELECT id,created,state,question,answer,error,tool_calls "
                                         "FROM tasks ORDER BY id DESC LIMIT ?", (n,))]
    def events(self, tid=None, n=50):
        q, a = ("WHERE task_id=?", (tid, n)) if tid else ("", (n,))
        return [{"task": t, "ts": ts, "kind": k, **json.loads(d)} for t, ts, k, d in self.db.execute(
            f"SELECT task_id,ts,kind,data FROM events {q} ORDER BY id DESC LIMIT ?", a)][::-1]
    def clear_history(self):
        with self.lock:
            self.db.execute("DELETE FROM events"); self.db.execute("DELETE FROM tasks")
        self._scrub()

    # notes: saved only on the user's explicit request; data, never instructions
    def add_note(self, text):
        text = " ".join((text or "").split())
        if not text:
            raise ValueError("nothing to remember")
        if len(text) > MAX_NOTE:
            raise ValueError(f"notes are limited to {MAX_NOTE} characters")
        if NOTE_SECRET.search(text):
            raise ValueError("notes can't hold passwords, keys or tokens; keep those in a password manager")
        with self.lock:
            if self.db.execute("SELECT count(*) FROM notes").fetchone()[0] >= MAX_NOTES:
                raise ValueError(f"notes are full ({MAX_NOTES}); forget some first")
            return self.db.execute("INSERT INTO notes(text, created) VALUES(?,?)",
                                   (text, time.time())).lastrowid
    def notes(self):
        return [{"id": i, "text": t, "created": c}
                for i, t, c in self.db.execute("SELECT rowid,text,created FROM notes ORDER BY rowid")]
    def forget(self, nid=None):
        with self.lock:
            if nid is None:
                n = self.db.execute("DELETE FROM notes").rowcount
            else:
                n = self.db.execute("DELETE FROM notes WHERE rowid=?", (nid,)).rowcount
            self.db.execute("INSERT INTO notes(notes) VALUES('optimize')")   # drop index remnants
        self._scrub()
        return n
    def _scrub(self):
        """Forgotten text must not linger in free pages or the WAL."""
        self.db.execute("VACUUM")
        self.db.execute("PRAGMA wal_checkpoint(TRUNCATE)")
    def search(self, text, k=3):
        words = [w for w in re.findall(r"[a-z0-9]{3,}", (text or "").lower()) if w not in STOPWORDS][:12]
        if not words:
            return []
        q = " OR ".join(f'"{w}"' for w in words)
        try:
            return list(self.db.execute("SELECT rowid,text FROM notes WHERE notes MATCH ? "
                                        "ORDER BY bm25(notes) LIMIT ?", (q, k)))
        except sqlite3.Error:
            return []

