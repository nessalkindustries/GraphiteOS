configuration { show-icons: true; icon-theme: "Papirus-Dark"; font: "JetBrainsMono Nerd Font 12"; }
@import "~/.config/graphite/current/rofi.rasi"
* { background-color: transparent; text-color: @fg; }
window { background-color: @bg; border: 2px; border-color: @accent; border-radius: 10px; width: 600px; }
inputbar { padding: 12px; children: [prompt, entry]; }
prompt { text-color: @accent; margin: 0 8px 0 0; }
element { padding: 8px; border-radius: 6px; }
element selected { background-color: @accent; text-color: @dark; }
