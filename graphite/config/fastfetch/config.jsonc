// Graphite fastfetch. The logo uses terminal colours 6/14 = theme accent/accent2.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/graphite/fastfetch/logo.txt",
    "color": { "1": "36", "2": "96", "3": "90" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": { "separator": "  ", "color": { "keys": "36" } },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[90m────────────────────────────" },
    { "type": "os",       "key": "󰣇 os" },
    { "type": "kernel",   "key": " kernel" },
    { "type": "wm",       "key": " wm" },
    { "type": "packages", "key": "󰏗 pkgs" },
    { "type": "shell",    "key": " shell" },
    { "type": "terminal", "key": " term" },
    { "type": "cpu",      "key": "󰻠 cpu", "format": "{name}" },
    { "type": "gpu",      "key": "󰍛 gpu", "format": "{name}" },
    { "type": "memory",   "key": " mem" },
    { "type": "disk",     "key": "󰋊 disk", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "uptime",   "key": "󰅐 up" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
