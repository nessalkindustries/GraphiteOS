# Generated by graphite-theme from {{name}}
general {
    hide_cursor = true
    ignore_empty_input = true
}
animations {
    enabled = true
    bezier = ease, 0.25, 0.1, 0.25, 1
    animation = fadeIn, 1, 4, ease
    animation = fadeOut, 1, 4, ease
}
background {
    monitor =
    path = {{wallpaper_path}}
    blur_passes = 3
    blur_size = 8
    brightness = {{lock_brightness}}
    vibrancy = 0.12
}
# time
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = rgb({{foreground.hex}})
    font_size = 96
    font_family = Inter Display Light
    position = 0, 170
    halign = center
    valign = center
}
# date
label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B"
    color = rgb({{muted.hex}})
    font_size = 18
    font_family = Inter
    position = 0, 80
    halign = center
    valign = center
}
input-field {
    monitor =
    size = 320, 52
    outline_thickness = 2
    rounding = -1
    dots_size = 0.22
    dots_spacing = 0.35
    outer_color = rgb({{accent.hex}}) rgb({{accent2.hex}}) 45deg
    inner_color = rgba({{surface.hex}}e6)
    font_color = rgb({{foreground.hex}})
    check_color = rgb({{accent2.hex}})
    fail_color = rgb({{red.hex}})
    capslock_color = rgb({{yellow.hex}})
    placeholder_text = <span foreground="#{{muted.hex}}">  $USER</span>
    fail_text = <span foreground="#{{red.hex}}">$FAIL</span>
    fade_on_empty = false
    font_family = Inter
    position = 0, -40
    halign = center
    valign = center
}
label {
    monitor =
    text = 󰌾  locked
    color = rgb({{muted.hex}})
    font_size = 11
    font_family = JetBrainsMono Nerd Font
    position = 0, 40
    halign = center
    valign = bottom
}
