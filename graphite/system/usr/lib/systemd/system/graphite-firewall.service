[Unit]
Description=Graphite default-deny inbound firewall (nftables)
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nft -f /etc/graphite/nftables.conf
ExecReload=/usr/bin/nft -f /etc/graphite/nftables.conf
ExecStop=/usr/bin/nft delete table inet graphite_filter

[Install]
WantedBy=sysinit.target
