#!/usr/bin/env bash
# Start waybar and make sure its layer actually maps. Under heavy load (software rendering in
# VMs) a waybar instance can miss the compositor's initial layer-shell configure ("Timed out
# waiting for initial .configure"); such an instance never maps, even if it later logs
# "Bar configured". Restart it as soon as that happens, otherwise give a slow start time.
#   graphite-bar            start (if not running) and wait until mapped  (exec-once at login)
#   graphite-bar --restart  stop the running bar first (theme switches)
# Env: GRAPHITE_BAR_TRIES (default 6), GRAPHITE_BAR_WAIT max seconds per try (default 60).
tries=${GRAPHITE_BAR_TRIES:-6}
wait=${GRAPHITE_BAR_WAIT:-60}
rt=${XDG_RUNTIME_DIR:-/tmp}
log=$rt/graphite-waybar.log
exec 8>"$rt/graphite-bar.lock"; flock -w 120 8 || true
mapped() { timeout 5 hyprctl layers 2>/dev/null | grep -q 'namespace: waybar'; }
say() { echo "graphite-bar $(date +%T): $*" >>"$log"; logger -t graphite-bar -- "$*" 2>/dev/null; }
stop() {
  pkill -x waybar 2>/dev/null
  for _ in $(seq 25); do pgrep -x waybar >/dev/null || break; sleep 0.2; done
  pkill -9 -x waybar 2>/dev/null
}
start() { : >"$rt/waybar.cur"; setsid -f sh -c 'exec waybar >>"$1" 2>&1' sh "$rt/waybar.cur"; }
[[ ${1:-} == --restart ]] && { say "restart requested"; stop; }
for ((i = 1; i <= tries; i++)); do
  if ! pgrep -x waybar >/dev/null; then say "starting waybar (try $i/$tries)"; start; fi
  for ((s = 0; s < wait * 2; s++)); do
    mapped && { say "waybar mapped (try $i)"; cat "$rt/waybar.cur" >>"$log" 2>/dev/null; exit 0; }
    if grep -q 'initial .configure' "$rt/waybar.cur" 2>/dev/null; then say "missed initial configure"; break; fi
    # waybar exited (e.g. early in the first login): restart now instead of idling out this try
    if ((s > 2)) && ! pgrep -x waybar >/dev/null; then say "waybar exited: $(tail -2 "$rt/waybar.cur" 2>/dev/null | tr '\n' ' ')"; break; fi
    sleep 0.5
  done
  cat "$rt/waybar.cur" >>"$log" 2>/dev/null
  say "waybar not mapped (try $i), restarting"; stop
done
say "giving up after $tries tries"; pgrep -x waybar >/dev/null || start
exit 1
