#!/usr/bin/env bash
# Graphite theme engine. A theme is a directory with colors.toml (flat
# `key = "value"` pairs). Applying renders $GRAPHITE_PATH/templates/*.tpl into
# ~/.config/graphite/current/ ({{key}} -> value, {{key.hex}} -> value without '#').
# mako has no include support, so ~/.config/mako/config is owned by the theme.
# Usage: graphite-theme list | current | set NAME | pick | apply
set -euo pipefail
GRAPHITE_PATH=${GRAPHITE_PATH:-/usr/share/graphite}
USER_THEMES="$HOME/.config/graphite/themes"   # user themes override shipped ones
STATE="$HOME/.config/graphite"
OUT="$STATE/current"

theme_dir() {
  local d
  for d in "$USER_THEMES/$1" "$GRAPHITE_PATH/themes/$1"; do
    [[ -f $d/colors.toml ]] && { echo "$d"; return 0; }
  done
  return 1
}
current() { cat "$STATE/theme" 2>/dev/null || echo graphite-teal; }

render() {
  local dir=$1 tpl key val line sedargs=() wp mode
  declare -A v=()
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*([a-z_0-9]+)[[:space:]]*=[[:space:]]*\"([^\"]*)\" ]] || continue
    v[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}
  done < "$dir/colors.toml"
  # derived values
  wp=${v[wallpaper]:-graphite.png}
  [[ $wp == /* ]] || wp="/usr/share/backgrounds/graphite/$wp"
  [[ -f $dir/$(basename "$wp") ]] && wp="$dir/$(basename "$wp")"
  [[ -f $wp ]] || wp=/usr/share/backgrounds/graphite/graphite.png
  mode=${v[mode]:-dark}
  v[wallpaper_path]=$wp
  v[home]=$HOME
  v[prefer_dark]=$([[ $mode == light ]] && echo 0 || echo 1)
  v[lock_brightness]=$([[ $mode == light ]] && echo 0.95 || echo 0.6)
  : "${v[gtk_theme]:=adw-gtk3-dark}" "${v[icon_theme]:=Papirus-Dark}" "${v[scheme]:=prefer-dark}"
  for key in "${!v[@]}"; do
    val=${v[$key]}
    sedargs+=(-e "s|{{$key}}|$val|g" -e "s|{{$key.hex}}|${val#\#}|g")
  done
  mkdir -p "$OUT"
  for tpl in "$GRAPHITE_PATH"/templates/*.tpl; do
    sed "${sedargs[@]}" "$tpl" > "$OUT/$(basename "${tpl%.tpl}")"
  done
  echo "$wp" > "$OUT/wallpaper"
  printf 'GTK_THEME_NAME=%s\nICON_THEME=%s\nCOLOR_SCHEME=%s\n' "${v[gtk_theme]}" "${v[icon_theme]}" "${v[scheme]}" > "$OUT/env"
  # files the theme owns outright (these programs have no include mechanism)
  mkdir -p "$HOME/.config/mako" "$HOME/.config/qt6ct" "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
  mv -f "$OUT/mako.config" "$HOME/.config/mako/config"
  # Quickshell bar prototype: the singleton must sit next to shell.qml
  mkdir -p "$HOME/.config/quickshell/graphite-bar"
  mv -f "$OUT/quickshell-colors.qml" "$HOME/.config/quickshell/graphite-bar/Colors.qml"
  mv -f "$OUT/qt6ct.conf" "$HOME/.config/qt6ct/qt6ct.conf"
  cp -f "$OUT/gtk-settings.ini" "$HOME/.config/gtk-3.0/settings.ini"
  mv -f "$OUT/gtk-settings.ini" "$HOME/.config/gtk-4.0/settings.ini"
}

reload_desktop() {
  # never let a stuck compositor socket hang the caller (smoke run 1 hung in a theme switch)
  hyprctl() { timeout 10 /usr/bin/hyprctl "$@"; }   # timeout execs the binary; "command" is a shell builtin, not an executable
  # GTK apps follow the gsettings keys live (needs a session bus; harmless without one)
  if command -v gsettings >/dev/null && [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    # shellcheck disable=SC1091
    . "$OUT/env"
    gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME_NAME" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface icon-theme "$ICON_THEME" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface color-scheme "$COLOR_SCHEME" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface cursor-theme capitaine-cursors 2>/dev/null || true
  fi
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || return 0
  hyprctl reload >/dev/null 2>&1 || true
  # waybar 0.15 can exit on SIGUSR2 reloads, so restart it cleanly. Always (re)start it, even if it
  # was already dead, and only after the old instance is really gone (under load a 2 s wait was
  # too short and the new bar lost the layer-shell race). Launch through Hyprland so the bar gets
  # the compositor's environment, not that of whatever called graphite-theme (rofi/keybind/tty).
  # Single, serialised restart. Root causes seen in the VM: (1) the previous "retry if not up after
  # 2 s" spawned a second bar because a freshly launched bar is still `sh -c` / not mapped for
  # several seconds under load; (2) the bar can take >30 s to map on a loaded machine, so callers
  # (and the smoke test) must wait for the layer, not assume a fixed delay.
  exec 9>"${XDG_RUNTIME_DIR:-/tmp}/graphite-theme.lock"; flock -w 60 9 || true
  pkill -x waybar 2>/dev/null || true
  for _ in $(seq 50); do pgrep -x waybar >/dev/null || break; sleep 0.2; done
  pkill -9 -x waybar 2>/dev/null || true
  local wl=${XDG_RUNTIME_DIR:-/tmp}/graphite-waybar.log
  # Launch ONLY through Hyprland. Root cause of the vanishing/duplicate bar: under load hyprctl can
  # return non-zero although the dispatch went through, and the old `|| setsid -f waybar` fallback
  # then started a second bar inside the *caller's* session (tty/ssh/rofi). That copy died with the
  # caller's session, or both ran stacked. Never start the bar outside the compositor.
  hyprctl dispatch exec "exec waybar >$wl 2>&1" >/dev/null 2>&1 || true
  # wait (bounded) for the new bar to map; relaunch only if no bar process exists at all
  for _ in $(seq 60); do hyprctl layers 2>/dev/null | grep -q 'namespace: waybar' && break; sleep 0.5; done
  pgrep -x waybar >/dev/null || hyprctl dispatch exec "exec waybar >>$wl 2>&1" >/dev/null 2>&1 || true
  makoctl reload 2>/dev/null || true
  pkill -SIGUSR1 -x kitty 2>/dev/null || true       # kitty reloads its config
  # new wallpaper: restart the wallpaper daemon detached from this shell
  pkill -x hyprpaper 2>/dev/null || true; pkill -x swaybg 2>/dev/null || true
  hyprctl dispatch exec graphite-wallpaper >/dev/null 2>&1 || true   # in the compositor session, not the caller's
}

case ${1:-current} in
  list)
    { ls "$GRAPHITE_PATH/themes"; ls "$USER_THEMES" 2>/dev/null || true; } | sort -u | while read -r t; do
      [[ $t == "$(current)" ]] && echo "* $t" || echo "  $t"
    done ;;
  current) current ;;
  set)
    name=${2:?usage: graphite-theme set NAME}
    dir=$(theme_dir "$name") || { echo "unknown theme: $name" >&2; exit 1; }
    mkdir -p "$STATE"; echo "$name" > "$STATE/theme"
    render "$dir"; reload_desktop; echo "theme: $name" ;;
  apply)
    dir=$(theme_dir "$(current)") || dir=$(theme_dir graphite-teal)
    render "$dir"; reload_desktop ;;
  pick)
    # rofi picker (Super+T): shows each theme's display name, applies the choice live
    choice=$(for t in $("$0" list | sed 's/^[* ] //'); do
               d=$(theme_dir "$t") || continue
               n=$(sed -n 's/^name *= *"\(.*\)"/\1/p' "$d/colors.toml")
               printf '%s\t%s\n' "$t" "${n:-$t}"
             done | rofi -dmenu -i -p "Theme" -display-columns 2 -display-column-separator '\t' \
                    -theme-str 'window { width: 420px; }') || exit 0
    exec "$0" set "${choice%%$'\t'*}" ;;
  *) echo "usage: graphite-theme list|current|set NAME|pick|apply" >&2; exit 1 ;;
esac
