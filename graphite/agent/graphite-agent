def _out(cmd, timeout=20):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout
    except (OSError, subprocess.TimeoutExpired):
        return 127, ""

def _themes():
    rc, o = _out(["graphite-theme", "list"])
    return [l.strip().lstrip("* ").strip() for l in o.splitlines() if l.strip()]

def setting_value(key):
    if key == "theme":
        return _out(["graphite-theme", "current"])[1].strip()
    if key == "bar":
        return (_read(os.path.join(GCONF, "bar")).strip() or "quickshell")
    rc, o = _out(["graphite-settings", "get", key])
    if rc:
        raise ValueError(f"can't read the current {SETTING_LABEL[key]}")
    return o.strip()

def plan_change_setting(key, value):
    v = value.strip()
    if key == "natural_scroll":
        v = {"on": "true", "yes": "true", "off": "false", "no": "false"}.get(v.lower(), v.lower())
    if key == "scale":
        v = {"1.0": "1", "2.0": "2", "3.0": "3", "100%": "1", "150%": "1.5", "200%": "2"}.get(v, v)
    if key == "theme":
        themes = _themes()
        v = v.lower().replace(" ", "-")
        if v not in themes and "graphite-" + v in themes:
            v = "graphite-" + v
        if v not in themes:
            raise ValueError(f"no theme '{value}'; installed: {', '.join(themes)}")
    elif not re.fullmatch(SETTINGS[key], v):
        raise ValueError(f"'{value}' is not a valid {SETTING_LABEL[key]}")
    cur = setting_value(key)
    if cur == v:
        raise ValueError(f"the {SETTING_LABEL[key]} is already {v}")
    return {"kind": "user", "args": {"key": key, "value": v}, "pre": {"current": cur},
            "summary": f"Change the {SETTING_LABEL[key]} from {cur or '(empty)'} to {v or '(empty)'}",
            "details": ["Your own settings: " + ", ".join(os.path.relpath(f, os.path.expanduser('~'))
                                                          for f in setting_files(key)),
                        "Snapshot: those files are copied to the undo journal first.",
                        f"Undo sets it back to {cur or '(empty)'} (refused if the files changed since)."]}

def _pkg_info(name):
    rc, o = _out(["pacman", "-Si", "--", name])
    if rc:
        return None
    info = {}
    for line in o.splitlines():
        k, _, v = line.partition(":")
        if v and k.strip() and k[0] != " ":
            info.setdefault(k.strip(), v.strip())
    return info

def _check_pkg(name):
    if not isinstance(name, str) or not PKG_NAME.fullmatch(name):
        raise ValueError("not a package name")
    if PROTECTED.match(name):
        raise ValueError(f"{name} is part of the system; the assistant won't install or remove it")

def plan_install_app(package):
    name = package.strip().lower()
    _check_pkg(name)
    if _out(["pacman", "-Qq", "--", name])[0] == 0:
        raise ValueError(f"{name} is already installed")
    info = _pkg_info(name)
    if not info:
        raise ValueError(f"no package called {name} in the repos (try: graphite apps search)")
    if info.get("Repository") not in ("core", "extra", "multilib"):
        raise ValueError(f"{name} is not from the official Arch repos")
    rc, o = _out(["pacman", "-Sp", "--print-format", "%n %s", "--", name], 30)
    pk = [l.split() for l in o.splitlines() if len(l.split()) == 2 and l.split()[1].isdigit()]
    if rc or not pk:
        raise ValueError(f"pacman can't plan installing {name}")
    mb = sum(int(x[1]) for x in pk) / 1e6
    return {"kind": "system", "args": {"package": name}, "pre": {"packages": [x[0] for x in pk]},
            "summary": f"Install {name} ({info.get('Description', '')[:80]})" +
                       (f" and {len(pk) - 1} dependencies" if len(pk) > 1 else "") + f", {mb:.0f} MB download",
            "details": ["System change: asks for your password.",
                        "Snapshot: a Btrfs snapshot of / is taken and checked first; if it fails, nothing is installed.",
                        "Undo removes exactly the packages this adds. The snapshot doesn't cover /home or /boot."]}

def plan_remove_app(package):
    name = package.strip().lower()
    _check_pkg(name)
    rc, o = _out(["pacman", "-Qi", "--", name])
    if rc:
        raise ValueError(f"{name} is not installed")
    req = re.search(r"^Required By\s*:\s*(.*)$", o, re.M)
    if req and req.group(1).strip() != "None":
        raise ValueError(f"{name} is needed by {req.group(1).strip()[:120]}; the assistant only removes apps nothing depends on")
    rc, o = _out(["pacman", "-Rnsp", "--print-format", "%n", "--", name], 30)
    pk = [l.strip() for l in o.splitlines() if PKG_NAME.fullmatch(l.strip())]
    if rc or not pk:
        raise ValueError(f"pacman can't plan removing {name}")
    return {"kind": "system", "args": {"package": name}, "pre": {"packages": pk},
            "summary": f"Remove {name}" + (f" and {len(pk) - 1} unused dependencies" if len(pk) > 1 else ""),
            "details": ["System change: asks for your password. Files in your home folder are not touched.",
                        "Snapshot: a Btrfs snapshot of / is taken and checked first; if it fails, nothing is removed.",
                        "Undo reinstalls the same packages from the repos (needs the network)."]}

ACTIONS = {
    "change_setting": (plan_change_setting, {"type": "object", "required": ["key", "value"], "properties": {
        "key": {"type": "string", "enum": list(SETTINGS)}, "value": {"type": "string", "maxLength": 40}}}),
    "install_app": (plan_install_app, {"type": "object", "required": ["package"], "properties": {
        "package": {"type": "string", "maxLength": 64}}}),
    "remove_app": (plan_remove_app, {"type": "object", "required": ["package"], "properties": {
        "package": {"type": "string", "maxLength": 64}}}),
}
ACTION_DESCRIPTIONS = {
    "change_setting": "Propose a settings change (theme, bar, scale, keyboard, pointer); the user approves it.",
    "install_app": "Propose installing an app from the Arch repos (package name); the user approves it.",
    "remove_app": "Propose removing an installed app (package name); the user approves it.",
}
SCHEMAS += [{"type": "function", "function": {"name": n, "description": ACTION_DESCRIPTIONS[n],
             "parameters": s}} for n, (_, s) in ACTIONS.items()]
ALL_TOOLS = list(TOOLS) + list(ACTIONS)

def propose(name, raw_args, store, tid):
    """A model-requested change: validate, store as awaiting approval. Returns (ok, result, public)."""
    ok, args = check_args(ACTIONS[name][1], raw_args)
    if not ok:
        return False, args, None
    try:
        plan = ACTIONS[name][0](**args)
    except ValueError as e:
        return False, {"error": str(e)}, None
    aid = store.add_action(tid, name, plan)
    public = {"id": aid, "summary": plan["summary"], "details": plan["details"], "scope": plan["kind"]}
    return True, {"status": "proposed; nothing has changed yet. The user must click Approve in the "
                            "panel", "action": f"a{aid}", "summary": plan["summary"]}, public

# ---------------------------------------------------------------- store: tasks, audit, notes

STATES = {"running": {"done", "failed", "cancelled", "interrupted"}}   # every other state is final
ACTION_STATES = {"awaiting_approval": {"running", "denied", "expired"},
                 "running": {"done", "failed", "interrupted"},
                 "done": {"undoing"}, "undo_failed": {"undoing"},
                 "undoing": {"undone", "undo_failed", "done"}}   # undoing -> done: undo refused
STOPWORDS = set("the a an and or of to in on for is are was were what which how do does did my "
                "me i you it its this that with can could at be about from have has any there "
                "please tell show".split())
NOTE_SECRET = re.compile(r"(?i)(pass(word|wd|phrase)|api[_ -]?key|secret|token|private key|"
                         r"-----BEGIN|\b[A-Za-z0-9+/_-]{32,}\b)")

class Store:
    """~/.local/share/graphite-agent/agent.db (0600, WAL, secure_delete): tasks, events, notes."""
    def __init__(self, path=None):
        path = path or DB_PATH
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        old = os.umask(0o077)
        try:
            self.db = sqlite3.connect(path, timeout=10, isolation_level=None, check_same_thread=False)
            x = self.db.execute
            x("PRAGMA journal_mode=WAL"); x("PRAGMA secure_delete=ON")
            x("CREATE TABLE IF NOT EXISTS tasks(id INTEGER PRIMARY KEY, created REAL, updated REAL,"
              " state TEXT, question TEXT, answer TEXT, error TEXT, tool_calls INTEGER DEFAULT 0)")
            x("CREATE TABLE IF NOT EXISTS events(id INTEGER PRIMARY KEY, task_id INTEGER, ts REAL,"
              " kind TEXT, data TEXT)")
            x("CREATE INDEX IF NOT EXISTS events_task ON events(task_id)")
            x("CREATE VIRTUAL TABLE IF NOT EXISTS notes USING fts5(text, created UNINDEXED,"
              " tokenize='porter unicode61')")
            x("CREATE TABLE IF NOT EXISTS prefs(key TEXT PRIMARY KEY, value TEXT)")
            x("CREATE TABLE IF NOT EXISTS actions(id INTEGER PRIMARY KEY, task_id INTEGER, created REAL,"
              " updated REAL, expires REAL, state TEXT, tool TEXT, plan TEXT, record TEXT, error TEXT,"
              " pid INTEGER)")
        finally:
            os.umask(old)
        self.lock = threading.Lock()

    def pref(self, key, default=None):
        r = self.db.execute("SELECT value FROM prefs WHERE key=?", (key,)).fetchone()
        return r[0] if r else default
    def set_pref(self, key, value):
        self.db.execute("INSERT OR REPLACE INTO prefs VALUES(?,?)", (key, value))

    # tasks: an explicit state machine; only running -> a final state is allowed
    def new_task(self, question):
        keep = self.pref("history", "on") == "on"
        now = time.time()
        with self.lock:
            tid = self.db.execute("INSERT INTO tasks(created,updated,state,question) VALUES(?,?,?,?)",
                                  (now, now, "running", question if keep else None)).lastrowid
        self.event(tid, "state", state="running")
        return tid
    def transition(self, tid, state, answer=None, error=None, tool_calls=None):
        with self.lock:
            r = self.db.execute("SELECT state FROM tasks WHERE id=?", (tid,)).fetchone()
            if not r or state not in STATES.get(r[0], ()):
                return False
            keep = self.pref("history", "on") == "on"
            self.db.execute("UPDATE tasks SET state=?, updated=?, answer=?, error=?,"
                            " tool_calls=COALESCE(?, tool_calls) WHERE id=?",
                            (state, time.time(), answer if keep else None, error, tool_calls, tid))
        self.event(tid, "state", state=state, **({"error": error} if error else {}))
        return True
    def event(self, tid, kind, **data):
        with self.lock:
            self.db.execute("INSERT INTO events(task_id,ts,kind,data) VALUES(?,?,?,?)",
                            (tid, time.time(), kind, json.dumps(data)[:4000]))
    def recover(self):
        """After a crash/restart: running tasks become interrupted. Nothing is replayed."""
        ids = [r[0] for r in self.db.execute("SELECT id FROM tasks WHERE state='running'")]
        for tid in ids:
            self.transition(tid, "interrupted", error="the agent stopped while this was running; "
                            "not resumed automatically")
        # an approve/undo whose process died mid-way: never re-run; the user decides
        for aid, st, pid in list(self.db.execute(
                "SELECT id,state,pid FROM actions WHERE state IN ('running','undoing')")):
            if pid and os.path.exists(f"/proc/{pid}"):
                continue
            if st == "running":
                self.act_transition(aid, ("running",), "interrupted", error="stopped mid-way; may be "
                                    "partly applied. Not retried. See the snapshot in its record.")
            else:
                self.act_transition(aid, ("undoing",), "undo_failed", error="undo stopped mid-way; not retried")
        return ids
    # actions: proposed by the model, approved/denied/undone only by the user
    def add_action(self, tid, tool, plan):
        now = time.time()
        with self.lock:
            aid = self.db.execute("INSERT INTO actions(task_id,created,updated,expires,state,tool,plan)"
                                  " VALUES(?,?,?,?,?,?,?)", (tid, now, now, now + ACTION_TTL,
                                  "awaiting_approval", tool, json.dumps(plan))).lastrowid
        self.event(tid, "action", id=aid, tool=tool, state="awaiting_approval", summary=plan["summary"])
        return aid
    def action(self, aid):
        r = self.db.execute("SELECT id,task_id,created,expires,state,tool,plan,record,error,pid "
                            "FROM actions WHERE id=?", (aid,)).fetchone()
        if not r:
            return None
        a = dict(zip(("id", "task", "created", "expires", "state", "tool", "plan", "record", "error",
                      "pid"), r))
        a["plan"] = json.loads(a["plan"])
        a["record"] = json.loads(a["record"]) if a["record"] else None
        if a["state"] == "awaiting_approval" and time.time() > a["expires"]:
            self.act_transition(aid, ("awaiting_approval",), "expired")
            a["state"] = "expired"
        return a
    def act_transition(self, aid, frm, to, record=None, error=None, pid=None):
        """Atomic compare-and-set: only one approve/undo can claim an action."""
        assert all(to in ACTION_STATES.get(f, ()) for f in frm)
        with self.lock:
            n = self.db.execute(
                f"UPDATE actions SET state=?, updated=?, record=COALESCE(?, record), error=?, pid=? "
                f"WHERE id=? AND state IN ({','.join('?' * len(frm))})",
                (to, time.time(), json.dumps(record) if record is not None else None, error, pid,
                 aid, *frm)).rowcount
            tid = (self.db.execute("SELECT task_id FROM actions WHERE id=?", (aid,)).fetchone() or [0])[0]
        if n:
            self.event(tid, "action", id=aid, state=to, **({"error": error} if error else {}))
        return n == 1
    def actions(self, n=20):
        ids = [r[0] for r in self.db.execute("SELECT id FROM actions ORDER BY id DESC LIMIT ?", (n,))]
        return [self.action(i) for i in ids]

    def prune(self):
        cut = time.time() - RETENTION_DAYS * 86400
        with self.lock:
            self.db.execute("DELETE FROM events WHERE task_id IN (SELECT id FROM tasks WHERE updated<?)", (cut,))
            self.db.execute("DELETE FROM tasks WHERE updated<?", (cut,))
    def tasks(self, n=20):
        return [dict(zip(("id", "created", "state", "question", "answer", "error", "tool_calls"), r))
                for r in self.db.execute("SELECT id,created,state,question,answer,error,tool_calls "
                                         "FROM tasks ORDER BY id DESC LIMIT ?", (n,))]
    def events(self, tid=None, n=50):
        q, a = ("WHERE task_id=?", (tid, n)) if tid else ("", (n,))
        return [{"task": t, "ts": ts, "kind": k, **json.loads(d)} for t, ts, k, d in self.db.execute(
            f"SELECT task_id,ts,kind,data FROM events {q} ORDER BY id DESC LIMIT ?", a)][::-1]
    def clear_history(self):
        with self.lock:
            self.db.execute("DELETE FROM events"); self.db.execute("DELETE FROM tasks")
            self.db.execute("DELETE FROM actions WHERE state NOT IN ('done','undo_failed','running','undoing')")
        self._scrub()

    # notes: saved only on the user's explicit request; data, never instructions
    def add_note(self, text):
        text = " ".join((text or "").split())
        if not text:
            raise ValueError("nothing to remember")
        if len(text) > MAX_NOTE:
            raise ValueError(f"notes are limited to {MAX_NOTE} characters")
        if NOTE_SECRET.search(text):
            raise ValueError("notes can't hold passwords, keys or tokens; keep those in a password manager")
        with self.lock:
            if self.db.execute("SELECT count(*) FROM notes").fetchone()[0] >= MAX_NOTES:
                raise ValueError(f"notes are full ({MAX_NOTES}); forget some first")
            return self.db.execute("INSERT INTO notes(text, created) VALUES(?,?)",
                                   (text, time.time())).lastrowid
    def notes(self):
        return [{"id": i, "text": t, "created": c}
                for i, t, c in self.db.execute("SELECT rowid,text,created FROM notes ORDER BY rowid")]
    def forget(self, nid=None):
        with self.lock:
            if nid is None:
                n = self.db.execute("DELETE FROM notes").rowcount
            else:
                n = self.db.execute("DELETE FROM notes WHERE rowid=?", (nid,)).rowcount
            self.db.execute("INSERT INTO notes(notes) VALUES('optimize')")   # drop index remnants
        self._scrub()
        return n
    def _scrub(self):
        """Forgotten text must not linger in free pages or the WAL."""
        self.db.execute("VACUUM")
        self.db.execute("PRAGMA wal_checkpoint(TRUNCATE)")
    def search(self, text, k=3):
        words = [w for w in re.findall(r"[a-z0-9]{3,}", (text or "").lower()) if w not in STOPWORDS][:12]
        if not words:
            return []
        q = " OR ".join(f'"{w}"' for w in words)
        try:
            return list(self.db.execute("SELECT rowid,text FROM notes WHERE notes MATCH ? "
                                        "ORDER BY bm25(notes) LIMIT ?", (q, k)))
        except sqlite3.Error:
            return []

