def check_args(schema, raw_args):
    """JSON-Schema subset check of model-supplied arguments. Returns (ok, args or error)."""
    try:
        args = json.loads(raw_args) if (raw_args or "").strip() else {}
    except ValueError:
        return False, {"error": "arguments are not valid JSON"}
    if not isinstance(args, dict):
        return False, {"error": "arguments must be an object"}
    props = schema["properties"]
    for k, v in args.items():
        if k not in props:
            return False, {"error": f"unknown argument '{k}'"}
        if props[k].get("type") == "string" and not isinstance(v, str):
            return False, {"error": f"'{k}' must be a string"}
        if "maxLength" in props[k] and len(v) > props[k]["maxLength"]:
            return False, {"error": f"'{k}' is too long"}
        if "enum" in props[k] and v not in props[k]["enum"]:
            return False, {"error": f"'{k}' must be one of {props[k]['enum']}"}
    for k in schema.get("required", []):
        if k not in args:
            return False, {"error": f"missing argument '{k}'"}
    return True, args

def run_tool(name, raw_args):
    """Validate a model-requested read-only call outside the model. Returns (ok, result)."""
    if name not in TOOLS:
        return False, {"error": f"tool '{name}' does not exist; the tools are {', '.join(ALL_TOOLS)}"}
    ok, args = check_args(TOOLS[name][1], raw_args)
    if not ok:
        return False, args
    try:
        return True, TOOLS[name][0](**args)
    except ValueError as e:         # refused by the tool's own validation (e.g. a path)
        return False, {"error": str(e)}
    except Exception as e:          # a read failed; report it, never crash the answer
        return False, {"error": f"{type(e).__name__}: {e}"}

# ---------------------------------------------------------------- actions (Stage 3)
# The model can only *propose* one of these. A proposal is validated here (outside the model),
# stored, and shown in the panel with exactly what will change; nothing happens until the user
# clicks Approve (`graphite-agent approve ID`, run by the panel in the desktop session). Before
# running: a snapshot (a file journal of the settings files for your own settings, a verified
# Btrfs snapshot of / through the privileged helper for software), then the change, then a check.
# Undo reverses it and refuses if the files changed since. Root snapshots don't cover /home or
# /boot; package undo removes/reinstalls exactly the recorded packages.
