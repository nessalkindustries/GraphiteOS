# ---------------------------------------------------------------- tools (read-only)

def _read(path, default=""):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return default

def _pkgver(name):
    """Installed version of a package, read from pacman's local db (no subprocess)."""
    db = "/var/lib/pacman/local"
    try:
        for d in os.listdir(db):
            if d.startswith(name + "-") and d[len(name) + 1:][:1].isdigit():
                lines = _read(os.path.join(db, d, "desc")).splitlines()
                if "%NAME%" in lines and lines[lines.index("%NAME%") + 1] == name:
                    return lines[lines.index("%VERSION%") + 1]
    except (OSError, ValueError, IndexError):
        pass
    return None

def os_release():
    info = {}
    for line in _read("/etc/os-release").splitlines():
        if "=" in line and not line.startswith("#"):
            k, v = line.split("=", 1)
            info[k] = v.strip().strip('"')
    return {"os": info.get("PRETTY_NAME") or info.get("NAME") or "unknown",
            "graphite_version": _read("/usr/share/graphite/VERSION").strip() or None,
            "graphite_config_package": _pkgver("graphite-config"),
            "hyprland": _pkgver("hyprland"),
            "kernel": platform.release(), "arch": platform.machine()}

def system_status():
    mem = {}
    for line in _read("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        if v.split():
            mem[k] = int(v.split()[0]) // 1024
    out = {"ram_total_mb": mem.get("MemTotal"), "ram_available_mb": mem.get("MemAvailable"),
           "swap_total_mb": mem.get("SwapTotal"), "swap_free_mb": mem.get("SwapFree")}
    for label, path in (("root", "/"), ("home", os.path.expanduser("~"))):
        try:
            du = shutil.disk_usage(path)
            g = 1 << 30   # GiB, the unit `df -h` shows
            out[f"disk_{label}"] = {"path": path, "total_gib": round(du.total / g, 1),
                                    "used_gib": round(du.used / g, 1), "free_gib": round(du.free / g, 1)}
        except OSError:
            pass
    try:
        up = float(_read("/proc/uptime", "0").split()[0])
        out["uptime_hours"] = round(up / 3600, 1)
        out["load_1_5_15"] = [float(x) for x in _read("/proc/loadavg").split()[:3]]
    except (ValueError, IndexError):
        pass
    out["cpu_threads"] = os.cpu_count()
    return out

HELP_TOPICS = ["keybinds", "apps", "settings", "updates", "agent", "all"]

def _help_sections():
    secs, cur = {}, None
    for line in _read(os.path.join(SHARE, "help.md")).splitlines():
        if line.startswith("## "):
            cur = line[3:].strip().lower()
            secs[cur] = []
        elif cur:
            secs[cur].append(line)
    keys = _read(os.path.join(SHARE, "keybinds.txt")).strip()
    if keys:
        secs.setdefault("keybinds", []).append(keys)
    return {k: "\n".join(v).strip() for k, v in secs.items()}

def graphite_help(topic="all"):
    secs = _help_sections()
    if topic == "all":
        return {k: v for k, v in secs.items() if k != "summary"}
    return {topic: secs.get(topic, "No help for this topic.")}

def _run(cmd, timeout=TOOL_TIMEOUT):
    """A fixed, read-only command (never model-supplied), bounded in time and output."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout[:4000]
    except (OSError, subprocess.TimeoutExpired):
        return ""

def network_status():
    out = {"interfaces": [], "default_route": False}
    for d in sorted(glob.glob("/sys/class/net/*")):
        n = os.path.basename(d)
        if n == "lo":
            continue
        out["interfaces"].append({"name": n, "state": _read(d + "/operstate").strip(),
                                  "wireless": os.path.isdir(d + "/wireless")})
    for line in _read("/proc/net/route").splitlines()[1:]:
        f = line.split()
        if len(f) > 2 and f[1] == "00000000":
            out["default_route"] = True
    try:
        for a in json.loads(_run(["ip", "-j", "-br", "addr"]) or "[]"):
            for i in out["interfaces"]:
                if i["name"] == a.get("ifname"):
                    i["addresses"] = [x["local"] for x in a.get("addr_info", []) if "local" in x][:4]
    except ValueError:
        pass
    act = _run(["nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection", "show", "--active"])
    out["active_connections"] = [l.replace("\\:", ":") for l in act.splitlines()[:6]]
    return out

def battery_status():
    out = {"batteries": [], "on_ac": None}
    for d in sorted(glob.glob("/sys/class/power_supply/*")):
        typ = _read(d + "/type").strip()
        if typ == "Battery":
            b = {"name": os.path.basename(d), "status": _read(d + "/status").strip()}
            cap = _read(d + "/capacity").strip()
            b["percent"] = int(cap) if cap.isdigit() else None
            out["batteries"].append(b)
        elif typ == "Mains":
            out["on_ac"] = _read(d + "/online").strip() == "1"
    if not out["batteries"]:
        out["note"] = "no battery (desktop or VM)"
    return out

def recent_updates():
    """The last package changes from /var/log/pacman.log (last 2 MB only)."""
    try:
        with open("/var/log/pacman.log", "rb") as f:
            f.seek(max(0, os.fstat(f.fileno()).st_size - (2 << 20)))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return {"error": "no pacman log"}
    last_upgrade = next((l[1:l.index("]")] for l in reversed(lines)
                         if "starting full system upgrade" in l and "]" in l), None)
    changes = [l for l in lines if "[ALPM] " in l and any(
        w in l for w in ("] upgraded ", "] installed ", "] removed ", "] downgraded "))]
    return {"last_full_upgrade": last_upgrade, "changes": [
        re.sub(r"^\[([^\]]+)\] \[ALPM\] ", r"\1 ", l) for l in changes[-15:]],
        "total_changes_in_log_tail": len(changes)}

def failed_services():
    sysf = _run(["systemctl", "--failed", "--plain", "--no-legend", "--no-pager"])
    usr = _run(["systemctl", "--user", "--failed", "--plain", "--no-legend", "--no-pager"])
    pick = lambda t: [l.split()[0] for l in t.splitlines() if l.split()][:20]
    return {"system_failed": pick(sysf), "user_failed": pick(usr)}

