class SockOut:
    def __init__(self, f, ctx):
        self.f, self.ctx, self.lock = f, ctx, threading.Lock()
    def emit(self, kind, **kw):
        try:
            with self.lock:
                self.f.write((json.dumps({"type": kind, **kw}) + "\n").encode())
                self.f.flush()
        except (OSError, ValueError):
            self.ctx.cancel()        # the client went away (Stop / panel closed): stop the answer

class Daemon:
    """One answer at a time; requests are JSON lines over a 0600 socket, same UID only."""
    def __init__(self):
        self.store = Store()
        self.store.recover()
        self.store.prune()
        self.gen = threading.Lock()
        self.current = None
        self.active, self.last, self.alock = 0, time.time(), threading.Lock()

    def serve(self, conn):
        with self.alock:
            self.active += 1
        try:
            self._serve(conn)
        finally:
            with self.alock:
                self.active -= 1
                self.last = time.time()

    def _serve(self, conn):
        try:
            uid = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                                      struct.calcsize("3i")))[1]
        except OSError:
            return
        if uid != os.getuid():
            return
        rf, wf = conn.makefile("rb"), conn.makefile("wb")
        try:
            self._request(conn, rf, wf)
        finally:
            for f in (rf, wf):
                try:
                    f.close()
                except OSError:
                    pass

    def _request(self, conn, rf, wf):
        reply = SockOut(wf, Ctx())
        line = rf.readline(MAX_MSG + 1)
        if len(line) > MAX_MSG or not line.endswith(b"\n"):
            return reply.emit("error", text="request too large or incomplete")
        try:
            req = json.loads(line)
            assert isinstance(req, dict)
        except (ValueError, AssertionError):
            return reply.emit("error", text="bad request")
        op = req.get("op")
        if op == "ask":
            return self.ask(conn, wf, req.get("q"))
        if op == "cancel":
            c = self.current
            if c:
                c.cancel()
            return reply.emit("ok", cancelled=bool(c))
        if op == "status":
            return reply.emit("status", busy=self.current is not None, pid=os.getpid())
        if op == "transcribe":        # one job at a time with answers: they share the CPU
            if not self.gen.acquire(timeout=1):   # the client deletes its recording
                return reply.emit("error", text="Another answer is still running. Stop it first.")
            try:
                return reply.emit("heard", text=_transcribe_owned(req.get("file")))
            except (ValueError, OSError) as e:
                return reply.emit("error", text=str(e))
            finally:
                self.gen.release()
        return self.extra(op, req, reply)

    def extra(self, op, req, reply):
        return reply.emit("error", text=f"unknown request {str(op)[:40]!r}")

    def ask(self, conn, wf, q):
        ctx = Ctx()
        out = SockOut(wf, ctx)
        if not isinstance(q, str):
            return out.emit("error", text="bad question")
        if not self.gen.acquire(timeout=1):
            out.emit("error", text="Another answer is still running. Stop it first.")
            return out.emit("exit", code=1)
        try:
            self.current = ctx
            def watch():                 # the client closing its end cancels the answer
                try:
                    while conn.recv(64):
                        pass
                except OSError:
                    pass
                ctx.cancel()
            threading.Thread(target=watch, daemon=True).start()
            try:
                rc = answer(q, out, ctx, self.store)
            except (OSError, urllib.error.URLError, http.client.HTTPException) as e:
                out.emit("error", text=f"Lost the local model: {e}")
                rc = 1
            out.emit("exit", code=rc)
        finally:
            self.current = None
            self.gen.release()

class _Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True

def _sock_alive(path):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(2)
    try:
        s.connect(path)
        return True
    except OSError:
        return False
    finally:
        s.close()

def run_daemon(daemon_cls=None):
    os.umask(0o077)
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)   # a client that went away is an error, not death
    d = (daemon_cls or Daemon)()
    class H(socketserver.BaseRequestHandler):
        def handle(self):
            d.serve(self.request)
    activated = os.environ.get("LISTEN_PID") == str(os.getpid()) and os.environ.get("LISTEN_FDS") == "1"
    if activated:                 # graphite-agent.socket made the 0600 socket for us
        srv = _Server(SOCK, H, bind_and_activate=False)
        srv.socket.close()
        srv.socket = socket.socket(fileno=3)
    else:
        os.makedirs(os.path.dirname(SOCK), mode=0o700, exist_ok=True)
        if os.path.exists(SOCK):
            if _sock_alive(SOCK):
                return 0          # another daemon already serves this user
            os.unlink(SOCK)
        srv = _Server(SOCK, H)
        os.chmod(SOCK, 0o600)
    def stop(*_):
        c = d.current
        if c:
            c.cancel()
        threading.Thread(target=srv.shutdown, daemon=True).start()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    def idle():
        while True:
            time.sleep(15)
            if d.active == 0 and time.time() - d.last > IDLE_EXIT:
                return stop()
    threading.Thread(target=idle, daemon=True).start()
    try:
        srv.serve_forever(poll_interval=0.5)
    finally:
        if not activated:
            try:
                os.unlink(SOCK)
            except OSError:
                pass
    return 0

def daemon_connect(start=True):
    """A connected socket to this user's daemon (started on demand), or None."""
    def conn():
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.connect(SOCK)
            return s
        except OSError:
            s.close()
            return None
    s = conn()
    if s or not start or os.environ.get("GRAPHITE_AGENT_NO_START"):
        return s
    try:
        subprocess.run(["systemctl", "--user", "start", DAEMON_UNIT], timeout=10,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        pass
    s = conn()
    if s:
        return s
    try:                          # no systemd user session (e.g. a plain tty): run it ourselves
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "daemon"], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return None
    for _ in range(50):
        time.sleep(0.1)
        s = conn()
        if s:
            return s
    return None

def daemon_request(req, start=False, timeout=5):
    """One short request; returns the reply dicts, or None if no daemon."""
    s = daemon_connect(start)
    if s is None:
        return None
    try:
        s.settimeout(timeout)
        s.sendall((json.dumps(req) + "\n").encode())
        return [json.loads(l) for l in s.makefile("rb") if l.strip()]
    except (OSError, ValueError):
        return None
    finally:
        s.close()

def ask_cmd(question, out):
    s = daemon_connect()
    if s is None:                 # no daemon possible: answer in this process (same rules)
        return answer(question, out)
    with s:
        s.sendall((json.dumps({"op": "ask", "q": question}) + "\n").encode())
        for line in s.makefile("rb"):
            try:
                m = json.loads(line)
            except ValueError:
                continue
            kind = m.pop("type", "")
            if kind == "exit":
                return m.get("code", 1)
            out.emit(kind, **m)
    out.emit("error", text="The agent daemon stopped. Try again.")
    return 1

# ---------------------------------------------------------------- approve / deny / undo

class Refused(Exception):
    pass

def _sha(path):
    try:
        return _sha256(path)
    except OSError:
        return None

def journal(files, jdir):
    """Copy files (content + mode) into the undo journal before a change."""
    os.makedirs(jdir, mode=0o700, exist_ok=True)
    out = []
    for i, f in enumerate(files):
        e = {"path": f, "existed": os.path.isfile(f)}
        if e["existed"]:
            e["copy"] = os.path.join(jdir, f"{i}-{os.path.basename(f)}")
            shutil.copy2(f, e["copy"])
            e["sha"], e["mode"] = _sha(f), os.stat(f).st_mode & 0o7777
            if _sha(e["copy"]) != e["sha"]:
                raise OSError(f"journal copy of {f} does not match")
        out.append(e)
    return out

def _restore(e):
    tmp = e["path"] + ".graphite-agent-undo"
    shutil.copyfile(e["copy"], tmp)
    os.chmod(tmp, e["mode"])
    os.replace(tmp, e["path"])

def _setting_set(key, value):
    cmd = ["graphite-theme", "set", value] if key == "theme" else ["graphite-settings", "set", key, value]
    rc, o = _out(cmd, 180)
    if rc:
        raise OSError(f"{' '.join(cmd[:3])} failed (exit {rc})")

def run_helper(*args):
    """The privileged helper through pkexec (password prompt in the desktop session)."""
    cmd = PKEXEC + [HELPER, *args]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=1800)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise OSError(f"could not run the helper: {e}")
    res = {}
    for line in reversed(r.stdout.splitlines()):
        try:
            res = json.loads(line)
            break
        except ValueError:
            continue
    if r.returncode in (126, 127) and not res:
        raise Refused("not authorised (password dialog dismissed?); nothing was changed")
    if res.get("ok") is False and "nothing was changed" in (res.get("error") or ""):
        raise Refused(res["error"])        # the helper stopped before changing anything
    if r.returncode or not res.get("ok"):
        raise OSError(res.get("error") or (r.stderr.strip().splitlines() or [f"exit {r.returncode}"])[-1][:300])
    return res

def execute(a, out):
    """Run an approved action: snapshot, change, verify. Returns the undo record."""
    tool, args, pre = a["tool"], a["plan"]["args"], a["plan"]["pre"]
    if tool == "change_setting":
        key, value = args["key"], args["value"]
        if setting_value(key) != pre["current"]:
            raise Refused(f"the {SETTING_LABEL[key]} changed since this was proposed; nothing was changed")
        out.emit("status", text="Snapshot: copying your settings files to the undo journal…")
        try:
            jr = journal(setting_files(key), os.path.join(DATA, "undo", str(a["id"])))
        except OSError as e:
            raise Refused(f"snapshot failed ({e}); nothing was changed")
        out.emit("status", text="Applying…")
        _setting_set(key, value)
        if setting_value(key) != value:
            raise OSError(f"the {SETTING_LABEL[key]} did not change")
        return {"journal": jr, "post": {f: _sha(f) for f in setting_files(key)}, "previous": pre["current"]}
    pkg = args["package"]
    out.emit("status", text="Waiting for your password, then a snapshot of / …")
    if tool == "install_app":
        r = run_helper("install", str(a["id"]), pkg)
        return {"snapshot": r.get("snapshot"), "added": r.get("added", [])}
    r = run_helper("remove", str(a["id"]), pkg)
    return {"snapshot": r.get("snapshot"), "removed": r.get("removed", []), "explicit": r.get("explicit", [])}

def revert(a, out):
    tool, rec = a["tool"], a["record"] or {}
    if tool == "change_setting":
        key = a["plan"]["args"]["key"]
        changed = [f for f, h in rec["post"].items() if _sha(f) != h]
        if changed:
            raise Refused("changed since (" + ", ".join(os.path.basename(f) for f in changed) +
                          "); undo refused so nothing of yours is overwritten")
        _setting_set(key, rec["previous"])
        for e in rec["journal"]:
            if e["existed"] and _sha(e["path"]) != e["sha"]:
                _restore(e)                     # exact bytes back from the journal
        if setting_value(key) != rec["previous"]:
            raise OSError(f"the {SETTING_LABEL[key]} is not back to {rec['previous']}")
        return {"restored": rec["previous"]}
    out.emit("status", text="Waiting for your password…")
    if tool == "install_app":
        if not rec.get("added"):
            return {"removed": []}
        r = run_helper("uninstall", str(a["id"]), *rec["added"])
        return {"snapshot": r.get("snapshot"), "removed": rec["added"]}
    deps = [p for p in rec.get("removed", []) if p not in rec.get("explicit", [])]
    r = run_helper("reinstall", str(a["id"]), "--deps", ",".join(deps) or "-", *rec.get("removed", []))
    return {"snapshot": r.get("snapshot"), "reinstalled": rec.get("removed", [])}

def action_cmd(cmd, args):
    jsonl = "--jsonl" in args
    args = [x for x in args if x != "--jsonl"]
    out = Out(jsonl)
    db = Store()
    if cmd == "actions":
        acts = [x for x in db.actions(30) if x]
        if "--json" in args:
            print(json.dumps([{k: x[k] for k in ("id", "state", "tool", "created", "error")} |
                              {"summary": x["plan"]["summary"], "details": x["plan"]["details"],
                               "kind": x["plan"]["kind"], "undoable": x["state"] in ("done", "undo_failed")}
                              for x in acts]))
        else:
            for x in acts:
                print(f"a{x['id']}  {_when(x['created'])}  {x['state']:<17} {x['plan']['summary']}"
                      + (f"  ({x['error']})" if x["error"] else ""))
        return 0
    if len(args) != 1 or not re.fullmatch(r"a?[0-9]+", args[0]):
        print(f"usage: graphite-agent {cmd} ID", file=sys.stderr)
        return 2
    aid = int(args[0].lstrip("a"))
    a = db.action(aid)
    if not a:
        out.emit("error", text=f"no action a{aid}")
        return 1
    def fail(msg, state_from, state_to, code=1):
        db.act_transition(aid, state_from, state_to, error=msg)
        out.emit("result", id=aid, state=state_to, text=msg)
        return code
    if cmd == "deny":
        if not db.act_transition(aid, ("awaiting_approval",), "denied"):
            out.emit("error", text=f"a{aid} is {a['state']}, not waiting for approval")
            return 1
        out.emit("result", id=aid, state="denied", text="Denied; nothing was changed.")
        out.emit("done")
        return 0
    if cmd == "approve":
        if a["state"] != "awaiting_approval" or not db.act_transition(
                aid, ("awaiting_approval",), "running", pid=os.getpid()):
            out.emit("error", text=f"a{aid} is {a['state']}; only a waiting proposal can be approved")
            return 1
        try:   # validate again, outside the model, at execution time
            ACTIONS[a["tool"]][0](**{k: a["plan"]["args"][k] for k in ACTIONS[a["tool"]][1]["required"]})
        except ValueError as e:
            return fail(f"no longer valid ({e}); nothing was changed", ("running",), "failed")
        try:
            rec = execute(a, out)
        except Refused as e:
            return fail(str(e), ("running",), "failed")
        except (OSError, ValueError, KeyError) as e:
            return fail(f"failed: {e}. Check it, then use Undo or the snapshot.", ("running",), "failed")
        db.act_transition(aid, ("running",), "done", record=rec)
        snap = f" Snapshot #{rec['snapshot']} of / was taken first." if rec.get("snapshot") else ""
        out.emit("result", id=aid, state="done", text=f"Done: {a['plan']['summary']}.{snap} Undo is in History.")
        out.emit("done")
        return 0
    if cmd == "undo":
        if a["state"] not in ("done", "undo_failed") or not db.act_transition(
                aid, ("done", "undo_failed"), "undoing", pid=os.getpid()):
            out.emit("error", text=f"a{aid} is {a['state']}; only a done change can be undone")
            return 1
        try:
            res = revert(a, out)
        except Refused as e:
            return fail(str(e), ("undoing",), "done")
        except (OSError, ValueError, KeyError) as e:
            return fail(f"undo failed: {e}", ("undoing",), "undo_failed")
        db.act_transition(aid, ("undoing",), "undone", record=dict(a["record"], undo=res))
        out.emit("result", id=aid, state="undone", text=f"Undone: {a['plan']['summary']}.")
        out.emit("done")
        return 0
    return 2

# ---------------------------------------------------------------- voice (offline)
# Speech to text: whisper.cpp (`whisper-cli`, Arch whisper-cpp) with ggml-base.en-q5_1 from the
# graphite-agent-voice-model package (ggerganov/whisper.cpp at commit 5359861, MIT; the same pin
# is in pkgs/graphite-agent-voice-model/PKGBUILD, change both together). Text to speech: RHVoice
# (`RHVoice-test`, English voice "slt"). Audio exists only in XDG_RUNTIME_DIR (RAM, the 0700
# graphite-agent dir), recording stops after MAX_LISTEN s, and each file is deleted as soon as it
# has been transcribed or played; no audio is ever kept. A spoken question is the same as a typed
# one: proposed changes still need Approve on the card.
VOICE_FILE = "ggml-base.en-q5_1.bin"
VOICE_URL = ("https://huggingface.co/ggerganov/whisper.cpp/resolve/"
             "5359861c739e955e79d9a303bcbc70fb988958b1/" + VOICE_FILE)
VOICE_SHA256 = "4baf70dd0d7c4247ba2b81fafd9c01005ac77c2f9ef064e00dcf195d0e2fdd2f"
VOICE_SIZE = 59721011
SYSTEM_VOICE = os.path.join(os.path.dirname(SYSTEM_MODEL), VOICE_FILE)  # graphite-agent-voice-model
USER_VOICE = os.path.join(MODEL_DIR, VOICE_FILE)
VOICE_DIR = os.path.dirname(SOCK)              # %t/graphite-agent, 0700, RAM
MAX_LISTEN = 30                                # s of audio per question
STT_TIMEOUT = 60
MAX_HEARD = 600                                # chars of transcript
MAX_SAY = 2000                                 # chars read aloud
TTS_VOICE = "slt"
# vocabulary hint for whisper (names it would otherwise spell as common words)
STT_PROMPT = ("Graphite, Hyprland, Quickshell, kitty, Nord, Catppuccin, Gruvbox, Wi-Fi, Bluetooth, "
              "pacman, cowsay, VLC, keyboard layout, natural scrolling.")
REC_NAME = re.compile(r"rec-[0-9a-f]{16}\.wav")

def voice_model():
    for p in (SYSTEM_VOICE, USER_VOICE):
        if os.path.exists(p):
            return p
    return None

def voice_state():
    return {"stt": bool(voice_model() and shutil.which("whisper-cli")),
            "mic": bool(shutil.which("pw-record")),
            "tts": bool(shutil.which("RHVoice-test") and shutil.which("pw-play")),
            "voice_model_path": voice_model()}

def _voice_dir():
    os.makedirs(VOICE_DIR, mode=0o700, exist_ok=True)
    st = os.lstat(VOICE_DIR)
    if st.st_uid != os.getuid() or st.st_mode & 0o077 or not os.path.isdir(VOICE_DIR) \
            or os.path.islink(VOICE_DIR):
        raise OSError(f"{VOICE_DIR} is not a private directory")
    now = time.time()                          # leftovers of a killed recording or playback:
    for f in glob.glob(os.path.join(VOICE_DIR, "*.wav")):   # owner process gone, or too old
        try:
            m = re.fullmatch(r"(?:rec|say)-([0-9a-f]{8})[0-9a-f]{8}\.wav", os.path.basename(f))
            if not m or not os.path.exists(f"/proc/{int(m.group(1), 16)}") \
                    or now - os.lstat(f).st_mtime > 600:
                os.unlink(f)
        except OSError:
            pass
    for w in ("listen", "say"):                # pidfile of a process that is gone
        if os.path.exists(_pidfile(w)) and not _signal_pidfile(w, 0, w):
            try:
                os.unlink(_pidfile(w))
            except OSError:
                pass
    return VOICE_DIR

def _audio_name(kind):
    """rec-/say- + owner pid + random: a crashed owner's file is swept on the next use."""
    return f"{kind}-{os.getpid() & 0xffffffff:08x}{os.urandom(4).hex()}.wav"

def _die_with_parent():
    try:                                       # PR_SET_PDEATHSIG: a killed panel stops the mic
        import ctypes
        ctypes.CDLL(None).prctl(1, signal.SIGTERM)
    except (OSError, AttributeError):
        pass

def _peak(path):
    """Peak sample (0..32767) of a 16-bit PCM wav; 0 if unreadable."""
    import array, wave
    try:
        with wave.open(path, "rb") as w:
            if w.getsampwidth() != 2:
                return 32767
            a = array.array("h", w.readframes(w.getnframes()))
    except (OSError, EOFError, wave.Error):
        return 0
    return max((abs(x) for x in a), default=0)

def transcribe(path):
    """Text spoken in a 16 kHz wav (whisper-cli, offline). Raises ValueError with a user message."""
    m = voice_model()
    if not m or not shutil.which("whisper-cli"):
        raise ValueError("Voice input isn't installed: sudo pacman -S graphite-agent-voice-model")
    if _peak(path) < 300:
        raise ValueError("I didn't hear anything. Is the microphone muted?")
    cmd = ["whisper-cli", "-m", m, "-f", path, "-l", "en", "-nt", "-np", "-t",
           str(max(1, min(4, os.cpu_count() or 1))), "--prompt", STT_PROMPT]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=STT_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise ValueError("Speech recognition took too long.")
    if r.returncode != 0:
        raise ValueError("Speech recognition failed.")
    # drop whisper's non-speech markers: [BLANK_AUDIO], (music), [Silence] ...
    text = re.sub(r"\[[^\]]*\]|\([^)]*\)|\*[^*]*\*", " ", r.stdout)
    text = " ".join(text.split())[:MAX_HEARD]
    if not re.search(r"\w", text):
        raise ValueError("I didn't catch that. Try again a little closer to the microphone.")
    return text

def _transcribe_owned(name):
    """Daemon side: transcribe and delete a recording in our own private dir (name only)."""
    if not isinstance(name, str) or not REC_NAME.fullmatch(name):
        raise ValueError("bad recording")
    path = os.path.join(_voice_dir(), name)
    try:
        st = os.lstat(path)
        if not (st.st_mode & 0o170000 == 0o100000) or st.st_uid != os.getuid():
            raise ValueError("bad recording")
        return transcribe(path)
    except FileNotFoundError:
        raise ValueError("The recording is gone.")
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass

def _pidfile(name):
    return os.path.join(VOICE_DIR, name + ".pid")

def _signal_pidfile(name, sig, word):
    """Signal the graphite-agent `word` process recorded in the pidfile; True if there was one."""
    try:
        pid = int(_read(_pidfile(name)).strip())
        cmd = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
        if os.stat(f"/proc/{pid}").st_uid != os.getuid() or \
                not any(c.endswith(b"graphite-agent") for c in cmd) or word.encode() not in cmd:
            return False
        os.kill(pid, sig)
        return True
    except (OSError, ValueError, AttributeError):
        return False

def listen_cmd(args, out):
    """Record from the default microphone until stopped (listen --stop, Esc, the button) or
    MAX_LISTEN s, then transcribe (in the daemon, one job at a time with answers)."""
    if "--stop" in args:
        return 0 if _signal_pidfile("listen", signal.SIGINT, "listen") else 1
    vd = _voice_dir()
    name = _audio_name("rec")
    path = os.path.join(vd, name)
    if "--file" in args:                       # transcribe an existing wav (tests, accessibility)
        src = args[args.index("--file") + 1]
        shutil.copyfile(src, path)
        os.chmod(path, 0o600)
    else:
        if not voice_state()["stt"]:
            out.emit("error", text="Voice input isn't installed: sudo pacman -S graphite-agent-voice-model")
            return 1
        if not shutil.which("pw-record"):
            out.emit("error", text="No pw-record (PipeWire) to record from the microphone.")
            return 1
        if _signal_pidfile("listen", 0, "listen"):
            out.emit("error", text="Already listening.")
            return 1
        with open(_pidfile("listen"), "w") as f:
            f.write(str(os.getpid()))
        stop = threading.Event()
        old = {s: signal.signal(s, lambda *_: stop.set()) for s in (signal.SIGINT, signal.SIGTERM)}
        try:
            old_umask = os.umask(0o077)
            try:
                rec = subprocess.Popen(["pw-record", "--rate", "16000", "--channels", "1",
                                        "--format", "s16", path], preexec_fn=_die_with_parent,
                                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL)
            finally:
                os.umask(old_umask)
            out.emit("listening", max=MAX_LISTEN)
            end = time.time() + MAX_LISTEN
            while not stop.is_set() and time.time() < end and rec.poll() is None:
                stop.wait(0.1)
            if rec.poll() is None:
                rec.send_signal(signal.SIGINT)     # pw-record finishes the wav header on SIGINT
                try:
                    rec.wait(3)
                except subprocess.TimeoutExpired:
                    rec.kill(); rec.wait()
        finally:
            for s, h in old.items():
                signal.signal(s, h)
            try:
                os.unlink(_pidfile("listen"))
            except OSError:
                pass
    out.emit("transcribing")
    try:
        r = daemon_request({"op": "transcribe", "file": name}, start=True, timeout=STT_TIMEOUT + 10)
        if r is None:                          # no daemon possible: same work in this process
            text = _transcribe_owned(name)
        elif r and r[0].get("type") == "heard":
            text = r[0]["text"]
        else:
            raise ValueError((r[0].get("text") if r else "") or "Speech recognition failed.")
    except ValueError as e:
        out.emit("error", text=str(e))
        return 1
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
    out.emit("heard", text=text)
    return 0

def speakable(text):
    """Answer text as it should be read: no markdown, citations or paths spelled out."""
    t = re.sub(r"```.*?```", " ", text, flags=re.S)
    t = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", t)
    t = re.sub(r"\[(?:n|a)?[0-9]+\]|\((?:note )?n[0-9]+\)", " ", t)      # [n3] (n3) citations
    t = re.sub(r"[`*_#>|]+", " ", t)
    t = " ".join(t.split())
    if len(t) > MAX_SAY:
        t = t[:MAX_SAY].rsplit(" ", 1)[0] + "."
    return t

def say_cmd(args):
    """Read text aloud offline (RHVoice -> pw-play); `say --stop` stops it."""
    if "--stop" in args:
        return 0 if _signal_pidfile("say", signal.SIGTERM, "say") else 1
    text = sys.stdin.read() if args in ([], ["-"]) else " ".join(args)
    text = speakable(text)
    if not text:
        return 0
    if not voice_state()["tts"]:
        print("Reading aloud needs rhvoice and pipewire (pw-play).", file=sys.stderr)
        return 1
    vd = _voice_dir()
    _signal_pidfile("say", signal.SIGTERM, "say")    # one voice at a time
    with open(_pidfile("say"), "w") as f:
        f.write(str(os.getpid()))
    path = os.path.join(vd, _audio_name("say"))
    procs = []
    def stop(*_):
        for p in procs:
            if p.poll() is None:
                p.terminate()
        raise KeyboardInterrupt
    old = {s: signal.signal(s, stop) for s in (signal.SIGINT, signal.SIGTERM)}
    try:
        old_umask = os.umask(0o077)
        try:
            p = subprocess.Popen(["RHVoice-test", "-p", TTS_VOICE, "-o", path], stdin=subprocess.PIPE,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 preexec_fn=_die_with_parent)
        finally:
            os.umask(old_umask)
        procs.append(p)
        p.communicate(text.encode(), timeout=60)
        if p.returncode != 0 or not os.path.exists(path):
            print("Speech synthesis failed.", file=sys.stderr)
            return 1
        p = subprocess.Popen(["pw-play", path], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, preexec_fn=_die_with_parent)
        procs.append(p)
        p.wait()
        return 0
    except KeyboardInterrupt:
        return 130
    except subprocess.TimeoutExpired:
        return 1
    finally:
        for s, h in old.items():
            signal.signal(s, h)
        for f in (path, _pidfile("say")):
            try:
                os.unlink(f)
            except OSError:
                pass

def voice_toggle():
    """Super+Alt+A: open the panel if needed and start (or stop) listening."""
    if not _pgrep(PANEL):
        panel("open")
    for _ in range(30):
        r = subprocess.run(["qs", "-c", "graphite-agent", "ipc", "call", "agent", "voice"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if r.returncode == 0:
            return 0
        time.sleep(0.2)
    return 1

# ---------------------------------------------------------------- panel / service control

def _pgrep(pattern):
    return subprocess.run(["pgrep", "-u", str(os.getuid()), "-f", pattern],
                          stdout=subprocess.DEVNULL).returncode == 0

def cancel():
    r = daemon_request({"op": "cancel"}) or [{}]
    if r[0].get("cancelled"):
        return                    # the daemon stopped it; its client ends by itself
    # no daemon answer running: stop an in-process answer (no-daemon fallback)
    subprocess.run(["pkill", "-u", str(os.getuid()), "-f", ASKS], stdout=subprocess.DEVNULL)

def unload():
    cancel()
    subprocess.run(["systemctl", "--user", "stop", SERVICE])

def sync_panel_config():
    """~/.config/quickshell/graphite-agent: the packaged shell.qml (kept up to date unless
    the user removed the marker line to keep their own edits) + the theme's Colors.qml."""
    d = os.path.expanduser("~/.config/quickshell/graphite-agent")
    os.makedirs(d, exist_ok=True)
    src, dst = os.path.join(SHARE, "quickshell", "shell.qml"), os.path.join(d, "shell.qml")
    mine = _read(dst)
    if not mine or ("graphite-agent: managed copy" in mine and mine != _read(src)):
        shutil.copyfile(src, dst)
    colors = os.path.join(d, "Colors.qml")
    bar = os.path.expanduser("~/.config/quickshell/graphite-bar/Colors.qml")
    if os.path.exists(bar) and (not os.path.exists(colors)
                                or os.path.getmtime(bar) > os.path.getmtime(colors)):
        shutil.copyfile(bar, colors)

def panel(action):
    running = _pgrep(PANEL)
    if action in ("toggle", "close") and running:
        cancel()
        subprocess.run(["pkill", "-u", str(os.getuid()), "-f", PANEL])
        return 0
    if action == "close" or running:
        return 0
    sync_panel_config()
    if model_path() and health() == "down":   # warm up while the panel opens
        subprocess.run(["systemctl", "--user", "start", "--no-block", SERVICE],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.Popen(["qs", "-c", "graphite-agent"], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0

def status(as_json):
    svc = subprocess.run(["systemctl", "--user", "is-active", SERVICE], capture_output=True,
                         text=True).stdout.strip() or "unknown"
    st = {"model": bool(model_path()), "model_path": model_path(), "service": svc,
          "server": health(), "llm": LLM}
    r = daemon_request({"op": "status"}) or [{}]
    st["daemon"] = "running" if r[0].get("type") == "status" else "stopped"
    st["busy"] = bool(r[0].get("busy"))
    db = _store()
    st["notes"] = len(db.notes()) if db else 0
    st["history"] = db.pref("history", "on") if db else "unknown"
    st.update(voice_state())
    if as_json:
        print(json.dumps(st))
    else:
        for k, v in st.items():
            print(f"{k}: {v}")
    return 0

def setup_model(which=("llm", "voice")):
    """Repair/fallback. Normally graphite-agent-model / graphite-agent-voice-model provide them."""
    rc = 0
    if "llm" in which:
        rc |= _setup_one("model", MODEL_FILE, SYSTEM_MODEL, USER_MODEL, MODEL_SHA256, MODEL_SIZE,
                         MODEL_URL, "graphite-agent-model")
    if "voice" in which:
        rc |= _setup_one("voice model", VOICE_FILE, SYSTEM_VOICE, USER_VOICE, VOICE_SHA256,
                         VOICE_SIZE, VOICE_URL, "graphite-agent-voice-model")
    return rc

def _setup_one(what, fname, system, user, sha, size, url, pkgname):
    if os.path.exists(system):
        print(f"Checking {system} ({pkgname}) …")
        if _sha256(system) == sha:
            print(f"The {what} is installed and verified.")
            return 0
        print(f"The packaged {what} is damaged. Repair it with: sudo pacman -S {pkgname}")
        return 1
    os.makedirs(MODEL_DIR, exist_ok=True)
    if os.path.exists(user):
        print(f"Checking {user} …")
        if _sha256(user) == sha:
            print(f"The {what} is already installed and verified.")
            return 0
        print("Checksum mismatch; replacing it.")
    free = shutil.disk_usage(MODEL_DIR).free
    if free < size + 200_000_000:
        print(f"Not enough space: need {size / 1e9:.1f} GB, have {free / 1e9:.1f} GB.")
        return 1
    part = user + ".part"
    local = [p for d in MODEL_PKG_DIRS for p in sorted(glob.glob(os.path.join(d, pkgname + "-[0-9]*.pkg.tar.zst")))]
    for pkg in local:   # offline first: a local package, e.g. the live ISO's /opt/graphite-repo
        print(f"Extracting the {what} from {pkg} …")
        with open(part, "wb") as f:
            r = subprocess.run(["bsdtar", "-xOf", pkg, "usr/share/graphite-agent/models/" + fname],
                               stdout=f)
        if r.returncode == 0 and _sha256(part) == sha:
            os.replace(part, user)
            print(f"The {what} is installed and verified. Open the agent with Super+Shift+A.")
            return 0
        print(f"That package did not contain a valid {what}; trying the next source.")
    print(f"Downloading {fname} ({size / 1e9:.2f} GB) from huggingface.co …")
    h, done, last = hashlib.sha256(), 0, 0.0
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "graphite-agent"})
        with urllib.request.urlopen(req, timeout=60) as r, open(part, "wb") as f:
            while chunk := r.read(1 << 20):
                f.write(chunk); h.update(chunk); done += len(chunk)
                if time.time() - last > 1:
                    last = time.time()
                    print(f"\r  {done * 100 // size:3d}%  {done / 1e6:7.0f} MB", end="", flush=True)
    except (OSError, urllib.error.URLError) as e:
        print(f"\nDownload failed: {e}")
        return 1
    print()
    if h.hexdigest() != sha:
        os.remove(part)
        print(f"Checksum mismatch (got {h.hexdigest()}); the file was removed.")
        return 1
    os.replace(part, user)
    print(f"The {what} is installed and verified. Open the agent with Super+Shift+A.")
    return 0

def serve(extra):
    """graphite-llm.service: exec llama-server on the resolved model (127.0.0.1 only)."""
    m = model_path()
    if not m:
        sys.exit("graphite-agent: no model installed (sudo pacman -S graphite-agent-model)")
    os.execvp("llama-server", ["llama-server", "-m", m] + SERVER_ARGS + extra)

def _sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while chunk := f.read(1 << 20):
            h.update(chunk)
    return h.hexdigest()

def _when(ts):
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(ts))

def notes_cmd(cmd, args):
    db = Store()
    js = "--json" in args
    args = [a for a in args if a != "--json"]
    if cmd == "remember":
        try:
            nid = db.add_note(" ".join(args))
        except ValueError as e:
            print(f"Not saved: {e}", file=sys.stderr)
            return 1
        print(json.dumps({"id": nid}) if js else f"Saved as n{nid}.")
        return 0
    if cmd == "notes":
        ns = db.notes()
        if js:
            print(json.dumps(ns))
        else:
            for n in ns:
                print(f"n{n['id']}  {_when(n['created'])}  {n['text']}")
            if not ns:
                print('No notes. Save one with: graphite-agent remember "..."')
        return 0
    if cmd == "forget":
        if args == ["--all"]:
            n = db.forget()
        elif len(args) == 1 and re.fullmatch(r"n?[0-9]+", args[0]):
            n = db.forget(int(args[0].lstrip("n")))
        else:
            print("usage: graphite-agent forget ID|--all", file=sys.stderr)
            return 2
        print(json.dumps({"forgotten": n}) if js else f"Forgot {n} note(s).")
        return 0 if n else 1
    if cmd == "export":
        data = json.dumps({"notes": db.notes(), "history": db.tasks(1000),
                           "exported": time.time()}, indent=1)
        if args:
            old = os.umask(0o077)
            try:
                with open(os.path.expanduser(args[0]), "w") as f:
                    f.write(data + "\n")
            finally:
                os.umask(old)
            print(f"Wrote {os.path.expanduser(args[0])}")
        else:
            print(data)
        return 0
    if cmd == "history":
        if args and args[0] in ("on", "off"):
            db.set_pref("history", args[0])
            print(f"history: {args[0]}")
            return 0
        if args and args[0] == "clear":
            db.clear_history()
            print("History and audit log cleared.")
            return 0
        ts = db.tasks(int(args[0]) if args and args[0].isdigit() else 20)
        if js:
            print(json.dumps(ts))
        else:
            for t in ts:
                print(f"#{t['id']}  {_when(t['created'])}  {t['state']:<11} {t['question'] or '(not kept)'}")
        return 0
    if cmd == "audit":
        ev = db.events(int(args[0].lstrip("#")) if args and args[0].lstrip("#").isdigit() else None)
        if js:
            print(json.dumps(ev))
        else:
            for e in ev:
                rest = {k: v for k, v in e.items() if k not in ("task", "ts", "kind")}
                print(f"#{e['task']}  {_when(e['ts'])}  {e['kind']:<10} {json.dumps(rest)}")
        return 0
    return 2

def main(argv):
    cmd = argv[0] if argv else "toggle"
    if cmd == "ask":
        jsonl = len(argv) > 1 and argv[1] == "--jsonl"
        out = Out(jsonl)
        try:
            return ask_cmd(" ".join(argv[2 if jsonl else 1:]), out)
        except (OSError, urllib.error.URLError) as e:
            out.emit("error", text=f"Lost the local model: {e}")
            return 1
    if cmd in ("toggle", "open", "close"):
        return panel(cmd)
    if cmd == "cancel":
        cancel(); return 0
    if cmd in ("unload", "stop"):
        unload(); return 0
    if cmd == "status":
        return status("--json" in argv)
    if cmd == "setup-model":
        return setup_model(("voice",) if "--voice" in argv else ("llm",) if "--llm" in argv
                           else ("llm", "voice"))
    if cmd == "serve":
        return serve(argv[1:])
    if cmd == "daemon":
        return run_daemon()
    if cmd == "listen":
        out = Out("--jsonl" in argv)
        try:
            return listen_cmd([a for a in argv[1:] if a != "--jsonl"], out)
        except OSError as e:
            out.emit("error", text=f"Recording failed: {e}")
            return 1
    if cmd == "say":
        return say_cmd(argv[1:])
    if cmd == "voice":
        return voice_toggle()
    if cmd in ("actions", "approve", "deny", "undo"):
        try:
            return action_cmd(cmd, argv[1:])
        except (OSError, sqlite3.Error) as e:
            print(f"graphite-agent: {e}", file=sys.stderr)
            return 1
    if cmd in ("remember", "notes", "forget", "export", "history", "audit"):
        try:
            return notes_cmd(cmd, argv[1:])
        except (OSError, sqlite3.Error) as e:
            print(f"graphite-agent: {e}", file=sys.stderr)
            return 1
    print(__doc__.split("\n\n", 2)[2].rstrip(), file=sys.stderr)
    return 0 if cmd in ("help", "-h", "--help") else 2

if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
