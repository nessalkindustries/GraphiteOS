# Generated by graphite-theme from {{name}} (theme owns this file; use `graphite theme set` to change)
font=Inter 10.5
background-color={{surface}}f2
text-color={{foreground}}
border-color={{accent}}
progress-color=over {{accent}}55
border-size=2
border-radius=12
padding=14,16
margin=12
outer-margin=6,10
width=360
max-icon-size=40
icons=1
icon-path=/usr/share/icons/{{icon_theme}}
default-timeout=5000
layer=overlay
anchor=top-right

[urgency=low]
border-color={{border}}

[urgency=critical]
border-color={{red}}
default-timeout=0

# graphite-notify dnd (Waybar opt-out): hide popups
[mode=do-not-disturb]
invisible=1
